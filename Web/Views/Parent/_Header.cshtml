@using System.Globalization
<!-- Header -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex">
                <div class="flex-shrink-0 flex items-center">
                    <a href="/Home/Index" class="text-xl font-bold text-red-600 tracking-wide flex items-center gap-2">
                        <i class="fa-solid fa-graduation-cap"></i>
                        ELMS
                    </a>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <!-- Language Switcher -->
                <div class="flex items-center gap-1 border border-slate-200 rounded-lg p-0.5 bg-slate-50">
                    <a href="?status=@ViewBag.CurrentStatus&culture=vi" 
                       class="px-2 py-0.5 rounded-md text-xs font-semibold transition-all @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "vi" ? "bg-red-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-150 hover:text-slate-900")">
                        VI
                    </a>
                    <a href="?status=@ViewBag.CurrentStatus&culture=en" 
                       class="px-2 py-0.5 rounded-md text-xs font-semibold transition-all @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en" ? "bg-red-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-150 hover:text-slate-900")">
                        EN
                    </a>
                </div>
                
                <span class="text-sm text-slate-500">@Localizer["parent_role_title"]</span>
                <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 font-semibold border border-slate-200">
                    P
                </div>
            </div>
        </div>
    </div>
</header>
