<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="manager-layout-container" style="display: flex; min-height: 100vh;">
        <partial name="_ManagerSidebar" />

        <div class="manager-main-content" style="flex: 1;">
            @RenderBody()
        </div>

    </div>

    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
