@model Application.Dtos.Identity.VerifyForgotPasswordRequest

@{
    ViewData["Title"] = "Verify OTP";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="text-center fw-bold mb-3">Verify OTP</h3>
                <p class="text-center text-muted small mb-4">We've sent a 6-digit code to <strong>@Model.Email</strong>.</p>

                <form asp-controller="Identity" asp-action="VerifyForgotPassword" method="post">
                    <input type="hidden" asp-for="Email" />

                    <!-- OTP Input -->
                    <div class="mb-4 text-center">
                        <label asp-for="Code" class="form-label fw-medium">Enter OTP Code</label>
                        <input asp-for="Code" type="text" class="form-control bg-light text-center fw-bold fs-4" placeholder="------" maxlength="6" required />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3 rounded-3 fw-medium">
                        Verify Code
                    </button>

                    <div class="text-center small">
                        <span class="text-muted">Didn't receive the code?</span>
                        <a href="/Identity/ForgotPassword" class="text-decoration-none fw-medium">Try again</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
