@model Application.Dtos.Identity.ForgotPasswordRequest

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="text-center fw-bold mb-3">Forgot Password</h3>
                <p class="text-center text-muted small mb-4">Enter your email address and we'll send you an OTP to reset your password.</p>

                <form asp-controller="Identity" asp-action="ForgotPassword" method="post">
                    <!-- Email -->
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-medium">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control bg-light" placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3 rounded-3 fw-medium">
                        Send OTP
                    </button>

                    <div class="text-center small">
                        <a href="/Identity/Login" class="text-decoration-none text-muted">
                            <i class="bi bi-arrow-left"></i> Back to login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>