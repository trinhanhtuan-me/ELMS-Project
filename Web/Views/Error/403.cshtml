@{
    Layout = null;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower();
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["error_403_title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'shake': 'shake 0.8s ease-in-out infinite alternate',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        shake: {
                            '0%': { transform: 'rotate(-3deg)' },
                            '100%': { transform: 'rotate(3deg)' }
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Font: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-slate-100 to-blue-50 flex items-center justify-center p-4 relative overflow-hidden">
    
    <!-- Background Decorative Elements -->
    <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-400/10 blur-3xl"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-red-400/10 blur-3xl"></div>

    <!-- Language Switcher -->
    <div class="absolute top-6 right-6 flex items-center gap-1 border border-slate-200/60 rounded-full p-0.5 bg-white/80 backdrop-blur-sm shadow-sm z-50">
        <button type="button" onclick="changeLanguage('vi')" 
                class="px-3 py-1 rounded-full text-xs font-bold transition-all @(currentCulture == "vi" ? "bg-blue-600 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")">
            VI
        </button>
        <button type="button" onclick="changeLanguage('en')" 
                class="px-3 py-1 rounded-full text-xs font-bold transition-all @(currentCulture == "en" ? "bg-blue-600 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")">
            EN
        </button>
    </div>

    <!-- Main Container -->
    <div class="max-w-md w-full text-center z-10 px-4">
        <!-- Main Card -->
        <div class="bg-white/85 backdrop-blur-md border border-slate-200/50 rounded-3xl p-8 md:p-10 shadow-2xl shadow-blue-900/5 relative overflow-hidden">
            <!-- Decorative inner top border gradient -->
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-red-500 via-amber-500 to-blue-600"></div>

            <!-- Error Code & Icon Container -->
            <div class="mb-6 flex flex-col items-center justify-center">
                <!-- SVG Icon representing Lock / Shield -->
                <div class="relative w-24 h-24 mb-4 flex items-center justify-center bg-red-50 rounded-full text-red-500 animate-float">
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                    <span class="absolute -top-1 -right-1 flex h-4 w-4">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500"></span>
                    </span>
                </div>
                <h1 class="text-8xl font-black bg-gradient-to-r from-red-600 to-amber-500 bg-clip-text text-transparent tracking-tighter leading-none">403</h1>
            </div>

            <!-- Message Headers -->
            <h2 class="text-2xl font-bold text-slate-800 mb-3">@Localizer["error_403_header"]</h2>
            <p class="text-slate-500 mb-8 text-sm leading-relaxed">
                @Localizer["error_403_desc"]
            </p>

            <!-- Navigation Actions -->
            <div class="flex flex-col sm:flex-row gap-3 justify-center items-stretch sm:items-center">
                <button type="button" onclick="history.back()" 
                        class="flex items-center justify-center gap-2 px-6 py-3 bg-white hover:bg-slate-50 text-slate-700 font-semibold rounded-xl border border-slate-200 transition-all hover:-translate-y-0.5 shadow-sm active:translate-y-0">
                    <i class="fa-solid fa-arrow-left text-xs"></i>
                    <span>@Localizer["error_btn_back"]</span>
                </button>
               
            </div>
        </div>

        <!-- Extra Help Footer -->
        <div class="mt-8 text-center text-xs text-slate-400">
            <p>@Localizer["error_need_help"] <a href="mailto:support@elms.com" class="text-blue-500 hover:text-blue-600 hover:underline font-semibold">@Localizer["error_contact_support"]</a></p>
        </div>
    </div>

    <!-- JS Cookie Language Switcher -->
    <script>
        function changeLanguage(culture) {
            const expires = new Date();
            expires.setFullYear(expires.getFullYear() + 1);
            const cookieValue = `c=${culture}|uic=${culture}`;
            document.cookie = `.AspNetCore.Culture=${encodeURIComponent(cookieValue)};expires=${expires.toUTCString()};path=/`;
            location.reload();
        }
    </script>
</body>
</html>
