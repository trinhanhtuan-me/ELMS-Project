@model Application.Dtos.Identity.ResetPasswordRequest

@{
    ViewData["Title"] = "Set New Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="text-center fw-bold mb-3">Set New Password</h3>
                <p class="text-center text-muted small mb-4">Please create a strong password that you don't use on any other website.</p>

                <form asp-controller="Identity" asp-action="ResetPassword" method="post">
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Code" />

                    <!-- New Password -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-medium">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control bg-light" placeholder="Enter new password" required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-medium">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
