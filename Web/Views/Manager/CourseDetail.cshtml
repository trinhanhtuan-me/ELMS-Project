@model Application.Dtos.Manager.CourseDetailVm
@{
    ViewData["Title"] = "Course Details - Manager Dashboard";
}

@section Styles {
    <!-- Must load this file to keep Sidebar and Topbar structure -->
    <link rel="stylesheet" href="~/css/manager-dashboard.css" asp-append-version="true" />

    <!-- Custom CSS for detail page -->
    <link rel="stylesheet" href="~/css/manager-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
}
<main class="main-content">

    <div class="container course-container">
        <div style="margin-bottom: 3rem;">
            @if (ViewBag.Source == "management")
            {
                <a href="@Url.Action("CourseManagement", "Manager")" class="btn btn-outline" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                    <i class="fas fa-arrow-left"></i> Back to Course Management
                </a>
            }
            else if (ViewBag.Source == "publish")
            {
                <a href="@Url.Action("CoursePublish", "Manager")" class="btn btn-outline" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                    <i class="fas fa-arrow-left"></i> Back to Course Publish
                </a>
            }
            else
            {
                <a href="@Url.Action("Dashboard", "Manager")" class="back-btn">
                    <i class="fa fa-arrow-left"></i> Back to Dashboard
                </a>
            }
        </div>

        <div class="course-detail-header">
            <div class="course-info">
                <h1 class="course-title">@Model.Title</h1>
                <p class="course-desc">
                    @(string.IsNullOrEmpty(Model.Description) ? "No description available." : Model.Description)
                </p>
                <p class="muted">
                    <i class="fa fa-calendar"></i> Created Date:
                    @(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "Unknown")
                </p>
            </div>

            <div class="course-meta">
                <p>
                    <strong>Status:</strong>
                    <span class="status-badge @Model.Status">@Model.Status</span>
                </p>
                <p>
                    <strong>Price:</strong>
                    @(Model.Price != null ? Model.Price.Value.ToString("N0") + " ₫" : "Not set")
                </p>
            </div>
        </div>

        <div class="action-buttons">
            @if (Model.Status == "submitted")
            {
                <form method="post" action="@Url.Action("Approve", "Manager")" style="display:inline-block;">
                    <input type="hidden" name="source" value="@ViewBag.Source" />
                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                    <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> Approve</button>
                </form>
                <button type="button" class="btn btn-danger" onclick="openRejectModal('@Model.CourseId')">
                    <i class="fa fa-times"></i> Reject
                </button>
            }
            else if (Model.Status == "approved")
            {
                <button type="button" class="btn btn-danger" onclick="openRejectModal('@Model.CourseId')">
                    <i class="fa fa-times"></i> Reject Again
                </button>
                <button type="button" class="btn btn-primary" onclick="openScheduleModal('@Model.CourseId')">
                    <i class="fa fa-upload"></i> Publish
                </button>
            }
            else if (Model.Status == "publish")
            {
                <form method="post" action="@Url.Action("Unpublish", "Manager")" style="display:inline-block;">
                    <input type="hidden" name="source" value="@ViewBag.Source" />
                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                    <button type="submit" class="btn btn-warning"><i class="fa fa-download"></i> Unpublish</button>
                </form>
            }
            else if (Model.Status == "unpublish")
            {
                <button type="button" class="btn btn-primary" onclick="openScheduleModal('@Model.CourseId')">
                    <i class="fa fa-upload"></i> Republish
                </button>
            }
        </div>

        <div class="course-overview">
            <section class="course-stats">
                <h3>Course Overview</h3>
                <ul>
                    <li>Modules: @Model.Stats.ModuleCount</li>
                    <li>Lessons: @Model.Stats.LessonCount</li>
                    <li>Quizzes: @Model.Stats.QuizCount</li>
                    <li>Assignments: @Model.Stats.AssignmentCount</li>
                    <li><strong>Total Content:</strong> @(Model.Stats.LessonCount + Model.Stats.QuizCount + Model.Stats.AssignmentCount + Model.Stats.DiscussionCount)</li>
                </ul>
            </section>

            <section class="course-instructor">
                <h3>Instructor</h3>
                <div class="instructor-card">
                    <p><strong>Full Name:</strong> @Model.Instructor.FullName</p>
                    <p><strong>Email:</strong> @Model.Instructor.Email</p>
                    <p><strong>Expertise:</strong> @(string.IsNullOrEmpty(Model.Instructor.Expertise) ? "Not updated" : Model.Instructor.Expertise)</p>
                    <p><strong>Bio:</strong> @(string.IsNullOrEmpty(Model.Instructor.Bio) ? "No description" : Model.Instructor.Bio)</p>
                </div>
            </section>
        </div>

        <section class="course-outline">
            <h3>Curriculum</h3>
            @if (!Model.Modules.Any())
            {
                <div class="empty">This course has no modules yet.</div>
            }
            else
            {
                @foreach (var m in Model.Modules)
                {
                    <div class="module">
                        <div class="module-header" onclick="toggleModule(this)">
                            <span>Module @m.OrderIndex: @m.Title</span>
                            <i class="fa fa-chevron-down"></i>
                        </div>

                        <div class="module-lessons" style="display:none;">
                            @foreach (var i in m.Items)
                            {
                                <div class="lesson-block">
                                    <div class="item-header" onclick="toggleItem(this)">
                                        <h4 class="item-title">
                                            @if (i.ItemType == "lesson")
                                            {
                                                <i class="fa fa-play-circle"></i>
                                            }
                                            else if (i.ItemType == "quiz")
                                            {

                                                <i class="fa fa-question-circle"></i>
                                            }
                                            else if (i.ItemType == "assignment")
                                            {

                                                <i class="fa fa-tasks"></i>
                                            }
                                            
                                            @i.Title
                                        </h4>
                                        <i class="fa fa-chevron-down toggle-icon"></i>
                                    </div>

                                    <div class="item-detail" style="display:none;">
                                        @if (i.ItemType == "lesson")
                                        {
                                            <p><strong>Content Type:</strong> @i.ContentType</p>
                                            @if (!string.IsNullOrEmpty(i.VideoUrl))
                                            {
                                                var embedUrl = i.VideoUrl.Replace("watch?v=", "embed/");
                                                <iframe width="560" height="315" src="@embedUrl" frameborder="0" allowfullscreen></iframe>
                                                <p><i class="fa fa-clock"></i> Duration: @i.DurationSec seconds</p>
                                            }
                                            @if (!string.IsNullOrEmpty(i.TextContent))
                                            {
                                                <div class="text-content">@Html.Raw(i.TextContent)</div>
                                            }
                                        }
                                        else if (i.ItemType == "quiz")
                                        {
                                            <p><strong>Time Limit:</strong> @(i.TimeLimitMin != null ? i.TimeLimitMin + " minutes" : "Unlimited")</p>
                                            <p>Passing Percentage: @i.QuizPassingPct%</p>
                                            <p>Random Questions: @i.PickCount</p>
                                        }
                                        else if (i.ItemType == "assignment")
                                        {
                                            <div class="assignment-detail">
                                                <p><strong>Submission Type:</strong> @i.SubmissionType</p>
                                                <p><strong>Passing Percentage:</strong> @i.AssignmentPassingPct%</p>
                                                @if (!string.IsNullOrEmpty(i.AssignmentInstructions))
                                                {
                                                    <div class="text-content"><h5>Instructions:</h5> @Html.Raw(i.AssignmentInstructions)</div>
                                                }
                                            </div>
                                        }

                                        



                                        @if (i.Questions != null && i.Questions.Any())
                                        {
                                            <div class="lesson-questions">
                                                <h5 style="margin-top: 15px;">Questions:</h5>
                                                @foreach (var q in i.Questions)
                                                {
                                                    <div class="question-item" style="margin-bottom: 15px; padding-left: 10px; border-left: 3px solid #ccc;">
                                                        <strong>Question:</strong> @Html.Raw(q.Content)

                                                        @if (!string.IsNullOrEmpty(q.Explanation))
                                                        {
                                                            <div class="muted"><em>Explanation:</em> @q.Explanation</div>
                                                        }

                                                        @if (q.Options != null && q.Options.Any())
                                                        {
                                                            <div class="option-list" style="margin-top: 5px;">
                                                                @foreach (var opt in q.Options)
                                                                {
                                                                    <div class="option" style="color: @(opt.IsCorrect ? "green" : "inherit"); font-weight: @(opt.IsCorrect ? "bold" : "normal");">
                                                                        <i class="fa @(opt.IsCorrect ? "fa-check-circle" : "fa-circle")"></i> @opt.Content
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </section>
    </div> <!-- END OF COURSE-CONTAINER -->
    <!-- Reuse Modal from Dashboard for consistency -->
    <div id="rejectModal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3>Enter Rejection Reason</h3>
            <form method="post" action="@Url.Action("Reject", "Manager")">
                <input type="hidden" name="source" value="@ViewBag.Source" />
                <input type="hidden" name="courseId" id="rejectCourseId">
                <textarea name="rejectReason" required placeholder="Enter reason..."></textarea>
                <div class="modal-buttons">
                    <button type="submit" class="btn btn-danger">Submit</button>
                    <button type="button" class="btn btn-secondary" onclick="closeRejectModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <div id="scheduleModal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3>Publish Course</h3>
            <form method="post" action="@Url.Action("Publish", "Manager")">
                <input type="hidden" name="source" value="@ViewBag.Source" />
                <input type="hidden" name="courseId" id="scheduleCourseId">

                
                <div class="form-group" style="margin-bottom: 16px;">
                    <label for="price" style="display:block; margin-bottom:5px; font-weight:bold;">Price (VND):</label>
                    <input type="number" name="price" id="price" class="form-control" style="width:100%; padding:8px;" required min="0" step="1000" placeholder="Example: 500000">
                </div>

                <div class="modal-buttons" style="display:flex; justify-content:flex-end; gap:10px;">
                    <button type="button" class="btn btn-secondary" onclick="closeScheduleModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color:#4f46e5; color:white; border:none; padding:8px 16px; border-radius:4px;">Save & Publish</button>
                </div>
            </form>
        </div>
    </div>

</main> <!-- CLOSE MAIN TAG -->
@section Scripts {
    <script>
        function toggleModule(h) {
            const c = h.nextElementSibling;
            const i = h.querySelector("i");
            const open = c.style.display === "block";

            // Close all other modules
            document.querySelectorAll('.module-lessons').forEach(e => e.style.display = "none");
            document.querySelectorAll('.module-header i').forEach(e => e.classList.replace("fa-chevron-up", "fa-chevron-down"));

            if (!open) {
                c.style.display = "block";
                i.classList.replace("fa-chevron-down", "fa-chevron-up");
            }
        }

        function toggleItem(h) {
            const d = h.nextElementSibling;
            const i = h.querySelector("i.toggle-icon");
            const open = d.style.display === "block";

            // Close all other items in the same module
            h.closest('.module-lessons').querySelectorAll(".item-detail").forEach(e => e.style.display = "none");
            h.closest('.module-lessons').querySelectorAll(".item-header i.toggle-icon").forEach(e => e.classList.replace("fa-chevron-up", "fa-chevron-down"));

            if (!open) {
                d.style.display = "block";
                i.classList.replace("fa-chevron-down", "fa-chevron-up");
            }
        }

        function openRejectModal(id) {
            document.getElementById('rejectCourseId').value = id;
            document.getElementById('rejectModal').style.display = 'flex';
        }
        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }
        function openScheduleModal(id) {
            document.getElementById('scheduleCourseId').value = id;
            document.getElementById('scheduleModal').style.display = 'flex';
        }
        function closeScheduleModal() {
            document.getElementById('scheduleModal').style.display = 'none';
        }
    </script>
}
