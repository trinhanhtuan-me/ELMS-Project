@model Application.Dtos.Lesson.QuizCreateRequest
@{
    Layout = "_ModuleContentLayout";
    ViewData["Title"] = "Create Quiz";
    var moduleId = ViewBag.ModuleId;
    var courseId = ViewBag.CourseId;
}

<div>
    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
        <i class="fas fa-question-circle text-purple-500 mr-3"></i> Create Quiz
    </h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-500"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-red-700 font-medium">Please check your input:</p>
                    <div class="text-sm text-red-600 mt-1" asp-validation-summary="All"></div>
                </div>
            </div>
        </div>
    }

    <form asp-action="CreateQuiz" asp-controller="Quiz" method="post" class="space-y-6">
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="ModuleId" />
        
        <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm">
            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Basic Information</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Quiz Title <span class="text-red-500">*</span></label>
                    <input asp-for="Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Enter title (e.g., Final Exam)" />
                    <span asp-validation-for="Title" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm">
            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Quiz Settings</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Passing Score (%) <span class="text-red-500">*</span></label>
                    <input asp-for="PassingScorePct" type="number" min="0" max="100" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
                    <span class="text-xs text-gray-500 mt-1 block">Percentage of correct answers required to pass the quiz (default: 50%).</span>
                    <span asp-validation-for="PassingScorePct" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Time Limit (Minutes)</label>
                    <input asp-for="TimeLimitMin" type="number" min="1" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Unlimited" />
                    <span class="text-xs text-gray-500 mt-1 block">Leave blank for unlimited time.</span>
                    <span asp-validation-for="TimeLimitMin" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Number of Questions to Show</label>
                    <input asp-for="PickCount" type="number" min="1" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="All" />
                    <span class="text-xs text-gray-500 mt-1 block">Number of questions chosen randomly. Leave blank to show all.</span>
                    <span asp-validation-for="PickCount" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Attempt Cooldown (Minutes) <span class="text-red-500">*</span></label>
                    <input asp-for="AttemptCooldownMin" type="number" min="0" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
                    <span class="text-xs text-gray-500 mt-1 block">Time student must wait before retaking (0: unlimited).</span>
                    <span asp-validation-for="AttemptCooldownMin" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
        </div>

        <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
            <a href="/Course/Details/@courseId" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm flex items-center">
                <i class="fas fa-save mr-2"></i> Save Quiz
            </button>
        </div>
    </form>
</div>
