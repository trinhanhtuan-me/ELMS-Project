@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!-- Sidebar Navigation -->
<aside class="w-full md:w-64 flex-shrink-0">
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-1">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider px-3 mb-3">@Localizer["menu_header"]</p>
        
        <a href="/ParentProgress/Index" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(controller == "ParentProgress" ? "bg-red-50 text-red-600" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fa-solid fa-chart-line text-base"></i>
            @Localizer["menu_student_progress"]
        </a>
        <a href="/ParentLink/Index" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(controller == "ParentLink" ? "bg-red-50 text-red-600" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fa-solid fa-user-group text-base"></i>
            @Localizer["menu_link_student"]
        </a>
        
        <a href="/CourseApproval/Index" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(controller == "CourseApproval" ? "bg-red-50 text-red-600" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fa-solid fa-graduation-cap text-base"></i>
            @Localizer["menu_course_approval"]
        </a>

        <a href="/Order/Index" 
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(controller == "Order" ? "bg-red-50 text-red-600" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
            <i class="fa-solid fa-file-invoice-dollar text-base"></i>
            @Localizer["order_history_title"]
        </a>
        
    </div>
</aside>
