@model Application.Dtos.ParentProfile.ParentProfileVm
@{
    Layout = "~/Views/Parent/_Layout.cshtml";
    ViewData["Title"] = Localizer["parent_profile_title"];
}

<div>
    <!-- Header -->
    <div class="mb-8 border-b border-slate-100 pb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-address-card text-blue-600"></i>
            @Localizer["parent_profile_title"]
        </h1>
        <p class="text-sm text-slate-500 mt-1">@Localizer["parent_profile_desc"]</p>
    </div>

    <form asp-action="Update" asp-controller="ParentProfile" method="post">
        <div class="flex flex-col lg:flex-row gap-8">
            
            <!-- Left Column: Avatar Section (Readonly/Default) -->
            <div class="w-full lg:w-1/4 shrink-0">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col items-center justify-center text-center shadow-sm">
                    <div class="relative mb-4">
                        <img src="https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(Model.FullName ?? Model.Username ?? "Parent"))&background=0d6efd&color=fff&size=160" 
                             alt="Avatar" class="rounded-full object-cover w-40 h-40 border-4 border-slate-50 shadow-md" />
                    </div>
                    <span class="text-sm font-semibold text-slate-700">@Model.FullName</span>
                    <small class="text-slate-400 text-xs mt-1">@Model.Email</small>
                </div>
            </div>

            <!-- Right Column: Profile Details -->
            <div class="flex-grow bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
                <!-- Row 1 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_username"]</label>
                        <input type="text" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500 focus:outline-none cursor-not-allowed" value="@Model.Username" readonly disabled>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_fullname"]</label>
                        <input type="text" asp-for="FullName" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_role"]</label>
                        <input type="text" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500 focus:outline-none cursor-not-allowed" value="@Localizer["parent_profile_role_value"]" readonly disabled>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_email"]</label>
                        <input type="email" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-500 focus:outline-none cursor-not-allowed" value="@Model.Email" readonly disabled>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_phone"]</label>
                        <input type="text" asp-for="Phone" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_dob"]</label>
                        <input type="date" asp-for="DateOfBirth" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-colors">
                    </div>
                </div>

                <!-- Row 3 -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_gender"]</label>
                        <select asp-for="Gender" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-colors">
                            <option value="">@Localizer["parent_profile_gender_select"]</option>
                            <option value="Male">@Localizer["parent_profile_gender_male"]</option>
                            <option value="Female">@Localizer["parent_profile_gender_female"]</option>
                            <option value="Other">@Localizer["parent_profile_gender_other"]</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_address"]</label>
                        <input type="text" asp-for="Address" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">@Localizer["parent_profile_occupation"]</label>
                        <input type="text" asp-for="Occupation" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none transition-colors">
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold transition shadow-sm hover:shadow">
                        @Localizer["parent_profile_btn_update"]
                    </button>
                </div>
            </div>

        </div>
    </form>
</div>
