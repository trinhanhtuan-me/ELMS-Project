@model Application.Dtos.Lesson.AssignmentUpdateRequest
@{
    ViewData["Title"] = "Update Assignment";
    Layout = "~/Views/Shared/_ModuleContentLayout.cshtml";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-tasks text-orange-500 mr-3"></i> Update Assignment
        </h2>
        
        <form asp-action="DeleteAssignment" asp-controller="Assignment" method="post" onsubmit="return confirm('Are you sure you want to delete this assignment?');">
            <input type="hidden" name="moduleItemId" value="@Model.ModuleItemId" />
            <input type="hidden" name="courseId" value="@Model.CourseId" />
            <button type="submit" class="px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors font-medium text-sm flex items-center">
                <i class="fas fa-trash-alt mr-2"></i> Delete
            </button>
        </form>
    </div>

    <form asp-action="UpdateAssignment" asp-controller="Assignment" method="post" enctype="multipart/form-data" class="space-y-6">
        <input type="hidden" asp-for="ModuleItemId" />
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="CurrentAttachmentUrl" />

        <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm space-y-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Assignment Title <span class="text-red-500">*</span></label>
                <input type="text" asp-for="Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" required>
                <span asp-validation-for="Title" class="text-red-500 text-sm mt-1"></span>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Content <span class="text-red-500">*</span></label>
                <textarea asp-for="Content" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors tinymce" placeholder="Detailed content of the assignment..."></textarea>
                <span asp-validation-for="Content" class="text-red-500 text-sm mt-1"></span>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Instructions</label>
                <textarea asp-for="Instructions" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors tinymce" placeholder="Instructions for students on how to do and submit the assignment..."></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Maximum Score</label>
                    <input type="number" asp-for="MaxScore" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" min="0">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Passing Score (%)</label>
                    <input type="number" asp-for="PassingScorePct" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" min="0" max="100">
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Submission Type</label>
                <select asp-for="SubmissionType" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" asp-items="Html.GetEnumSelectList<Domain.Enums.AssignmentSubmissionType>()"></select>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">New Attachment (Leave blank to keep current)</label>
                <input type="file" asp-for="AttachmentFile" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-colors"/>
                
                @if (!string.IsNullOrEmpty(Model.CurrentAttachmentUrl))
                {
                    <div class="mt-3 p-3 bg-blue-50 text-blue-800 rounded-md text-sm flex items-center justify-between border border-blue-100">
                        <span class="flex items-center"><i class="fas fa-paperclip mr-2"></i> Current Attachment</span>
                        <a href="@Model.CurrentAttachmentUrl" target="_blank" class="text-blue-600 hover:underline font-semibold flex items-center">
                            Download <i class="fas fa-download ml-1 text-xs"></i>
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-gray-100">
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm flex items-center">
                <i class="fas fa-save mr-2"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      tinymce.init({
        selector: '.tinymce',
        height: 400,
        menubar: false,
        plugins: [
          'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
          'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
          'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
        ],
        toolbar: 'undo redo | blocks | ' +
        'bold italic forecolor | alignleft aligncenter ' +
        'alignright alignjustify | bullist numlist outdent indent | ' +
        'removeformat | help',
        content_style: 'body { font-family:Inter,Helvetica,Arial,sans-serif; font-size:16px }'
      });
    </script>
}
