@model Application.Dtos.Learning.AssignmentLearningDto

<div class="assignment-container mx-auto" style="max-width: 900px;">
    <h2 class="mb-4 fw-bold">Assignment: @Model.Title</h2>

    <!-- Submission Status -->
    @if (Model.Status == Domain.Enums.AssignmentWorkStatus.Submitted)
    {
    <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i> Status: <strong>Submitted</strong> (Pending grading)</div>
    }
    else if (Model.Status == Domain.Enums.AssignmentWorkStatus.Returned)
    {
    <div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i> Status: <strong>Returned for revision</strong><br />Feedback: @Model.FeedbackText</div>
    }
    else if (Model.Status == Domain.Enums.AssignmentWorkStatus.Passed)
    {
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i> Status: <strong>Passed</strong> (Score: @Model.Score/@Model.MaxScore)</div>
    }

    <!-- Block 1: Instructions -->
    <div class="card mb-4 bg-light border-0">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Instructions</h5>
            <div class="mb-3 text-dark">
                @if (!string.IsNullOrEmpty(Model.Content)) { <p>@Html.Raw(Model.Content)</p> }
                @Html.Raw(Model.Instructions)
            </div>

            <div class="fs-6 mt-3 text-secondary border-top pt-3">
                <span class="me-4"><strong>Passing score:</strong> @Model.PassingScorePct%</span>
                <span><strong>Submission type:</strong> @Model.SubmissionType.ToString().ToUpper()</span>
            </div>
        </div>
    </div>

    <!-- Block 2: Work Area -->
    <form id="assignmentForm" enctype="multipart/form-data">
        <input type="hidden" name="itemId" value="@Model.ItemId" />

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Your Work</h5>

                @if (Model.SubmissionType == Domain.Enums.AssignmentSubmissionType.Text)
                {
                <textarea name="textAnswer" class="form-control bg-light" rows="12" placeholder="Enter your answer here..." required @(Model.Status == Domain.Enums.AssignmentWorkStatus.Submitted || Model.Status == Domain.Enums.AssignmentWorkStatus.Passed ? "readonly" : "")>@Model.TextAnswer</textarea>
                }
                else
                {
                <input type="file" name="file" class="form-control bg-light p-3" accept=".pdf,.doc,.docx" required @(Model.Status == Domain.Enums.AssignmentWorkStatus.Submitted || Model.Status == Domain.Enums.AssignmentWorkStatus.Passed ? "disabled" : "") />

                @if(!string.IsNullOrEmpty(Model.FileUrl)) {
                <div class="mt-3">
                    <i class="fas fa-file-pdf text-danger me-1"></i> <a href="@Model.FileUrl" target="_blank" class="text-decoration-none">View saved file</a>
                </div>
                }
                }
            </div>

            <!-- Block 3: Action Buttons -->
            <div class="card-footer bg-white border-0 p-4 pt-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        @if (Model.DraftSavedAt.HasValue && Model.Status != Domain.Enums.AssignmentWorkStatus.Submitted && Model.Status != Domain.Enums.AssignmentWorkStatus.Passed)
                        {
                        <small class="text-muted">Draft saved at @Model.DraftSavedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                        }
                    </div>

                    @if (Model.Status != Domain.Enums.AssignmentWorkStatus.Submitted && Model.Status != Domain.Enums.AssignmentWorkStatus.Passed)
                    {
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary px-4 fw-bold" onclick="submitAssignment('submit')">Submit Assignment</button>
                        <button type="button" class="btn btn-outline-secondary px-4 bg-white" onclick="submitAssignment('draft')">Save Draft</button>
                    </div>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function submitAssignment(type) {
        var fd = new FormData(document.getElementById('assignmentForm'));
        fd.append("actionType", type);

        $.ajax({
            url: '/Learning/SubmitAssignment',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: r => {
                alert(r.message); 
                if (r.success) loadItem('@Model.ItemId', $('.learning-item.active'));
            },
            error: () => alert("Failed to submit assignment. Please try again later.")
        });
    }
</script>