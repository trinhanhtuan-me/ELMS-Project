@using Domain.Enums;
@model Application.Common.PaginatedList<Application.Dtos.Billing.CourseRequestResponseDto>

@{
    Layout = "~/Views/Parent/_Layout.cshtml";
    ViewData["Title"] = Localizer["course_approval_title"] ?? "Duyệt Đăng Ký Khóa Học";
    var currentStatus = ViewBag.CurrentStatus as string ?? "Pending";
    
    int currentPage = int.TryParse(Context.Request.Query["pageNumber"].ToString(), out var p) && p > 0 ? p : 1;
    int pageSize = 6;
    int totalItems = Model.Total;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    if (totalPages < 1) totalPages = 1;
}

<div>
    <!-- Header -->
    <div class="mb-8 border-b border-slate-100 pb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                @Localizer["course_approval_title"]
            </h1>
            <p class="text-sm text-slate-500 mt-1">@Localizer["course_approval_description"]</p>
        </div>
        @if (currentStatus == "Unpaid" && Model.Data.Any())
        {
            <a href="@Url.Action("Index", "Payment")" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 text-white rounded-xl text-sm font-medium hover:bg-emerald-700 transition shadow-sm">
                <i class="fa-solid fa-credit-card"></i>
                @Localizer["payment_submit_button"] (@Model.Total)
            </a>
        }
    </div>

    <!-- Tab Filters -->
    <div class="mb-8 border-b border-slate-200">
        <nav class="-mb-px flex gap-6" aria-label="Tabs">
            <a href="@Url.Action("Index", "CourseApproval", new { status = "Pending" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Pending" ? "border-amber-500 text-amber-600 font-semibold" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-hourglass-half mr-1.5"></i>
                @Localizer["status_pending"]
            </a>
            
            <a href="@Url.Action("Index", "CourseApproval", new { status = "Unpaid" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Unpaid" ? "border-sky-500 text-sky-600 font-semibold" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-receipt mr-1.5"></i>
                @Localizer["status_unpaid"]
            </a>

            <a href="@Url.Action("Index", "CourseApproval", new { status = "Approved" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Approved" ? "border-emerald-500 text-emerald-600 font-semibold" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-circle-check mr-1.5"></i>
                @Localizer["status_approved"]
            </a>
            
            <a href="@Url.Action("Index", "CourseApproval", new { status = "Rejected" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Rejected" ? "border-rose-500 text-rose-600 font-semibold" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-circle-xmark mr-1.5"></i>
                @Localizer["status_rejected"]
            </a>
        </nav>
    </div>

    <!-- Main Content Grid -->
    @if (!Model.Data.Any())
    {
        <div class="text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
            <div class="h-12 w-12 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-folder-open text-slate-400 text-xl"></i>
            </div>
            <h3 class="text-slate-700 font-medium text-base">@Localizer["course_approval_no_data_title"]</h3>
            <p class="text-slate-400 text-xs mt-1">@Localizer["course_approval_no_data_desc"]</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            @foreach (var item in Model.Data)
            {
                <div class="bg-white rounded-2xl border border-slate-150 p-6 shadow-sm flex flex-col justify-between hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden group">
                    @if (currentStatus == "Pending")
                    {
                        <div class="absolute top-0 inset-x-0 h-1.5 bg-amber-400"></div>
                    }
                    else if (currentStatus == "Unpaid")
                    {
                        <div class="absolute top-0 inset-x-0 h-1.5 bg-sky-400"></div>
                    }
                    else if (currentStatus == "Approved")
                    {
                        <div class="absolute top-0 inset-x-0 h-1.5 bg-emerald-400"></div>
                    }
                    else if (currentStatus == "Rejected")
                    {
                        <div class="absolute top-0 inset-x-0 h-1.5 bg-rose-400"></div>
                    }

                    <div>
                        <!-- Student Header Info -->
                        <div class="flex items-center gap-3.5 mb-5 mt-1">
                            <div class="h-11 w-11 bg-indigo-50 text-indigo-650 rounded-full flex items-center justify-center font-extrabold text-sm shrink-0 border border-indigo-100/50 shadow-sm">
                                @(string.IsNullOrEmpty(item.StudentName) ? "ST" : item.StudentName.Substring(0, Math.Min(2, item.StudentName.Length)).ToUpper())
                            </div>
                            <div class="overflow-hidden">
                                <h4 class="text-slate-800 font-bold text-sm tracking-tight leading-snug">@item.StudentName</h4>
                                <p class="text-slate-400 text-xs mt-0.5 truncate">@item.StudentEmail</p>
                            </div>
                        </div>

                        <!-- Course & Details block -->
                        <div class="space-y-4 border-t border-b border-slate-100 py-4 my-4">
                            <!-- Course Name -->
                            <div class="flex items-start gap-3 w-full">
                                <div class="w-8 h-8 rounded-xl bg-indigo-50/60 text-indigo-600 flex items-center justify-center shrink-0 mt-0.5 border border-indigo-100/30">
                                    <i class="fa-solid fa-graduation-cap text-xs"></i>
                                </div>
                                <div class="min-w-0 flex-grow">
                                    <div class="flex justify-between items-start gap-2">
                                        <div class="min-w-0 flex-grow">
                                            <span class="text-slate-400 text-[10px] uppercase tracking-wider font-extrabold block">@Localizer["course_approval_course_label"]</span>
                                            <span class="text-slate-700 font-bold text-sm block mt-0.5 leading-snug truncate" title="@item.CourseName">@item.CourseName</span>
                                        </div>
                                        <button type="button" onclick="openPreviewModal('@item.CourseId')" 
                                                class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 hover:text-indigo-700 rounded-xl text-xxs font-bold transition-all border border-indigo-100/40 shadow-sm hover:shadow active:scale-95 duration-150">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Fee & Date (Grid side-by-side) -->
                            <div class="grid grid-cols-2 gap-4 pt-1">
                                <div class="flex items-start gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-emerald-50/60 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100/30">
                                        <i class="fa-solid fa-tags text-xs"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <span class="text-slate-400 text-[10px] uppercase tracking-wider font-extrabold block">@Localizer["course_approval_fee_label"]</span>
                                        <span class="text-emerald-700 font-extrabold text-sm block mt-0.5 whitespace-nowrap">@item.PriceVnd.ToString("N0") VND</span>
                                    </div>
                                </div>
                                <div class="flex items-start gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-sky-50/60 text-sky-600 flex items-center justify-center shrink-0 border border-sky-100/30">
                                        <i class="fa-solid fa-calendar-day text-xs"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <span class="text-slate-400 text-[10px] uppercase tracking-wider font-extrabold block">@Localizer["course_approval_date_requested"]</span>
                                        <span class="text-slate-600 font-bold text-xs block mt-1.5 whitespace-nowrap">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Notes Block -->
                        @if (!string.IsNullOrEmpty(item.Note))
                        {
                            <div class="bg-slate-50/70 rounded-xl p-3.5 text-slate-600 text-xs border border-slate-100 flex gap-2.5 items-start mt-2">
                                <i class="fa-solid fa-quote-left text-slate-350 text-xs mt-0.5 shrink-0"></i>
                                <span class="break-words leading-relaxed italic">@item.Note</span>
                            </div>
                        }
                    </div>

                    <!-- Action Buttons or Status Badge -->
                    @if (currentStatus == "Pending")
                    {
                        <div class="grid grid-cols-2 gap-3 mt-6 border-t border-slate-100 pt-4">
                            <button onclick="openRejectModal('@item.RequestId', '@item.StudentName', '@item.CourseName')" 
                                    class="py-3 bg-rose-50 hover:bg-rose-100/80 text-rose-600 text-xs font-bold rounded-xl transition duration-150 flex items-center justify-center gap-1.5 border border-rose-100/50">
                                <i class="fa-solid fa-circle-xmark"></i>
                                @Localizer["course_approval_btn_reject"]
                            </button>
                            <button onclick="openApproveModal('@item.RequestId', '@item.StudentName', '@item.CourseName')" 
                                    class="py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition duration-150 shadow-sm hover:shadow-md flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-circle-check"></i>
                                @Localizer["course_approval_btn_approve"]
                            </button>
                        </div>
                    }
                    else if (currentStatus == "Unpaid")
                    {
                        <div class="mt-5 pt-3.5 border-t border-slate-100">
                            <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-50 text-amber-600 text-xxs font-bold rounded-lg border border-amber-100/40">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                @Localizer["course_approval_status_unpaid"]
                            </span>
                        </div>
                    }
                    else if (currentStatus == "Approved")
                    {
                        <div class="mt-5 pt-3.5 border-t border-slate-100 flex justify-between items-center text-slate-400 text-xxs">
                            <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-50 text-emerald-600 text-xxs font-bold rounded-lg border border-emerald-100/40">
                                <i class="fa-solid fa-circle-check"></i>
                                @Localizer["course_approval_status_approved"]
                            </span>
                            <span class="font-medium">@item.DecidedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="flex justify-center items-center gap-2 mt-10">
                <a href="@(currentPage > 1 ? Url.Action("Index", new { status = currentStatus, pageNumber = currentPage - 1 }) : "#")"
                   class="h-9 w-9 border border-slate-200 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-50 transition @(currentPage == 1 ? "opacity-40 cursor-not-allowed" : "")">
                    <i class="fa-solid fa-angle-left"></i>
                </a>
                
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="@Url.Action("Index", new { status = currentStatus, pageNumber = i })"
                       class="h-9 w-9 rounded-lg flex items-center justify-center text-sm font-semibold transition @(currentPage == i ? "bg-indigo-600 text-white" : "border border-slate-200 text-slate-600 hover:bg-slate-50")">
                        @i
                    </a>
                }

                <a href="@(currentPage < totalPages ? Url.Action("Index", new { status = currentStatus, pageNumber = currentPage + 1 }) : "#")"
                   class="h-9 w-9 border border-slate-200 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-50 transition @(currentPage == totalPages ? "opacity-40 cursor-not-allowed" : "")">
                    <i class="fa-solid fa-angle-right"></i>
                </a>
            </div>
        }
    }
</div>

<!-- ================= APPROVE MODAL ================= -->
<div id="approveModal" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-300">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 max-w-md w-full overflow-hidden transform scale-95 transition-transform duration-300">
        <div class="p-6">
            <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4 mx-auto text-xl">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800 text-center">@Localizer["approve_modal_title"]</h3>
            <p class="text-sm text-slate-500 mt-2 text-center">
                @Localizer["approve_modal_body_prefix"] <b id="approveStudentName"></b> @Localizer["approve_modal_body_infix"] <b id="approveCourseName"></b>? 
            </p>
            <p class="text-xs text-slate-400 mt-1.5 text-center">@Localizer["approve_modal_info"]</p>
            
            <form asp-action="Approve" method="post" class="mt-6">
                <input type="hidden" name="RequestId" id="approveRequestId" />
                <div class="mb-4">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">@Localizer["approve_modal_note_label"]</label>
                    <textarea name="Note" rows="2" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none resize-none" placeholder="@Localizer["approve_modal_placeholder"]"></textarea>
                </div>
                <div class="flex gap-3 justify-end">
                    <button type="button" onclick="closeApproveModal()" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-50 rounded-xl border border-slate-200 transition">@Localizer["btn_cancel"]</button>
                    <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition">@Localizer["approve_modal_btn_submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= REJECT MODAL ================= -->
<div id="rejectModal" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-300">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 max-w-md w-full overflow-hidden transform scale-95 transition-transform duration-300">
        <div class="p-6">
            <div class="w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mb-4 mx-auto text-xl">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800 text-center">@Localizer["reject_modal_title"]</h3>
            <p class="text-sm text-slate-500 mt-2 text-center">
                @Localizer["reject_modal_body_prefix"] <b id="rejectStudentName"></b> @Localizer["reject_modal_body_infix"] <b id="rejectCourseName"></b>@Localizer["reject_modal_body_suffix"]
            </p>
            
            <form asp-action="Reject" method="post" id="rejectForm" class="mt-6" onsubmit="return validateRejectForm()">
                <input type="hidden" name="RequestId" id="rejectRequestId" />
                <div class="mb-4">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">@Localizer["reject_modal_reason_label"]</label>
                    <textarea name="Note" id="rejectNote" rows="3" required class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 outline-none resize-none" placeholder="@Localizer["reject_modal_placeholder"]"></textarea>
                    <span id="rejectError" class="text-xxs text-rose-500 font-semibold hidden mt-1"><i class="fa-solid fa-circle-exclamation mr-1"></i>@Localizer["err_reject_reason_required"]</span>
                </div>
                <div class="flex gap-3 justify-end">
                    <button type="button" onclick="closeRejectModal()" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-50 rounded-xl border border-slate-200 transition">@Localizer["btn_cancel"]</button>
                    <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-sm transition">@Localizer["reject_modal_btn_submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="~/Views/Parent/CourseApproval/_PreviewModal.cshtml" />

<script>
    function openApproveModal(id, studentName, courseName) {
        document.getElementById('approveRequestId').value = id;
        document.getElementById('approveStudentName').innerText = studentName;
        document.getElementById('approveCourseName').innerText = courseName;
        
        const modal = document.getElementById('approveModal');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.firstElementChild.classList.remove('scale-95');
        }, 10);
    }
    
    function closeApproveModal() {
        const modal = document.getElementById('approveModal');
        modal.firstElementChild.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    function openRejectModal(id, studentName, courseName) {
        document.getElementById('rejectRequestId').value = id;
        document.getElementById('rejectStudentName').innerText = studentName;
        document.getElementById('rejectCourseName').innerText = courseName;
        document.getElementById('rejectNote').value = "";
        document.getElementById('rejectError').classList.add('hidden');
        
        const modal = document.getElementById('rejectModal');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.firstElementChild.classList.remove('scale-95');
        }, 10);
    }
    
    function closeRejectModal() {
        const modal = document.getElementById('rejectModal');
        modal.firstElementChild.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    function validateRejectForm() {
        const note = document.getElementById('rejectNote').value.trim();
        if (!note) {
            document.getElementById('rejectError').classList.remove('hidden');
            return false;
        }
        return true;
    }


</script>
