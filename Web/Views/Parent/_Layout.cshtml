<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["parent_portal_title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Font: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <!-- Header -->
    <partial name="~/Views/Parent/_Header.cshtml" />

    <div class="flex-grow max-w-7xl w-full mx-auto flex flex-col md:flex-row px-4 sm:px-6 lg:px-8 py-8 gap-8">
        <!-- Sidebar Navigation -->
        <partial name="~/Views/Parent/_Sidebar.cshtml" />

        <!-- Main Content -->
        <main class="flex-grow bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-slate-500">
            @Localizer["copyright"]
        </div>
    </footer>

    <!-- Tailwind Toast Container -->
    <div class="fixed top-4 right-4 z-50 space-y-2">
        @if (TempData["SuccessToast"] != null)
        {
            <div id="toast-success" class="flex items-center w-full max-w-xs p-4 text-slate-600 bg-white rounded-xl shadow-lg border border-emerald-100 transition-opacity duration-300" role="alert">
                <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-emerald-500 bg-emerald-50 rounded-lg">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="ml-3 text-sm font-medium">@TempData["SuccessToast"]</div>
                <button type="button" onclick="document.getElementById('toast-success').remove()" class="ml-auto -mx-1.5 -my-1.5 bg-white text-slate-400 hover:text-slate-900 rounded-lg p-1.5 hover:bg-slate-50 inline-flex h-8 w-8" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }

        @if (TempData["ErrorToast"] != null)
        {
            <div id="toast-error" class="flex items-center w-full max-w-xs p-4 text-slate-600 bg-white rounded-xl shadow-lg border border-rose-100 transition-opacity duration-300" role="alert">
                <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-rose-500 bg-rose-50 rounded-lg">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="ml-3 text-sm font-medium">@TempData["ErrorToast"]</div>
                <button type="button" onclick="document.getElementById('toast-error').remove()" class="ml-auto -mx-1.5 -my-1.5 bg-white text-slate-400 hover:text-slate-900 rounded-lg p-1.5 hover:bg-slate-50 inline-flex h-8 w-8" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var sToast = document.getElementById('toast-success');
            if (sToast) {
                setTimeout(function () {
                    sToast.style.opacity = '0';
                    setTimeout(function () { sToast.remove(); }, 300);
                }, 5000);
            }
            var eToast = document.getElementById('toast-error');
            if (eToast) {
                setTimeout(function () {
                    eToast.style.opacity = '0';
                    setTimeout(function () { eToast.remove(); }, 300);
                }, 5000);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
