@model Web.ViewModels.StudentFamilyViewModel
@using Domain.Enums

<div class="row">
    <!-- Left Column: Parent Link -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Parent Account Link</h6>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label text-muted">Student Name</label>
                    <input type="text" class="form-control bg-light" value="@Model.StudentName" readonly />
                </div>

                @if (Model.ParentLinkStatus == "NotLinked")
                {
                    <form asp-controller="StudentFamily" asp-action="SendRequest" method="post">
                        <div class="mb-3">
                            <label class="form-label text-muted">Parent Email:</label>
                            <input type="email" name="ParentEmail" class="form-control" placeholder="Enter parent's email here" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            Send Link Request
                        </button>
                    </form>
                }
                else if (Model.ParentLinkStatus == "Pending")
                {
                    <form asp-controller="StudentFamily" asp-action="CancelRequest" method="post">
                        <input type="hidden" name="RequestId" value="@Model.ParentLinkRequestId" />
                        <div class="mb-3">
                            <label class="form-label text-muted">Parent Email:</label>
                            <input type="text" class="form-control bg-light" value="@Model.ParentEmail" readonly />
                            <div class="text-warning mt-2 small fw-bold">
                                <i class="bi bi-hourglass-split"></i> Waiting for parent's approval...
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger w-100">
                            Cancel Request
                        </button>
                    </form>
                }
                else if (Model.ParentLinkStatus == "Linked")
                {
                    <form asp-controller="StudentFamily" asp-action="Unlink" method="post">
                        <input type="hidden" name="ParentId" value="@Model.ParentId" />
                        <div class="mb-3">
                            <label class="form-label text-muted">Parent Email:</label>
                            <input type="text" class="form-control bg-light border-success" value="@Model.ParentEmail" readonly />
                            <div class="text-success mt-2 small fw-bold">
                                <i class="bi bi-check-circle-fill"></i> Successfully linked
                            </div>
                        </div>
                        <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Are you sure you want to unlink this account?');">
                            Unlink Account
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Course Requests -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <!-- Filter & Search Bar -->
            <div class="card-header bg-white py-3 border-bottom-0">
                <form method="get" asp-action="Index" class="row g-2 align-items-center">
                    <div class="col-auto">
                        <label class="visually-hidden">Status Filter</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Saved">Saved</option>
                            <option value="Unpaid">Unpaid</option>
                        </select>
                    </div>
                    <div class="col">
                        <input type="text" name="keyword" class="form-control form-control-sm" placeholder="e.g. IELTS..." value="@Context.Request.Query["keyword"]" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-sm">Search</button>
                    </div>
                </form>
            </div>

            <!-- Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Course</th>
                                <th>Status</th>
                                <th>Note</th>
                                <th class="text-center pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CourseRequests == null || !Model.CourseRequests.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        You don't have any course requests yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.CourseRequests)
                                {
                                    <tr>
                                        <!-- Column 1: Course Name -->
                                        <td class="fw-medium ps-3">@item.CourseName</td>

                                        <!-- Column 2: Status Badges -->
                                        <td>
                                            @switch (item.Status)
                                            {
                                                case CourseRequestStatus.Saved:
                                                    <span class="badge bg-secondary rounded-pill">Saved</span>
                                                    break;
                                                case CourseRequestStatus.Pending:
                                                    <span class="badge bg-warning text-dark rounded-pill">Pending</span>
                                                    break;
                                                case CourseRequestStatus.Unpaid:
                                                    <span class="badge bg-info text-dark rounded-pill">Unpaid</span>
                                                    break;
                                                case CourseRequestStatus.Approved:
                                                    <span class="badge bg-success rounded-pill">Approved</span>
                                                    break;
                                                case CourseRequestStatus.Canceled:
                                                    <span class="badge bg-primary rounded-pill">Canceled</span>
                                                    break;
                                                case CourseRequestStatus.Rejected:
                                                    <span class="badge bg-danger rounded-pill">Rejected</span>
                                                    break;
                                            }
                                        </td>

                                        <!-- Column 3: Note -->
                                        <td class="text-muted">@item.Note</td>

                                        <!-- Column 4: Actions -->
                                        <td class="text-center pe-3">
                                            
                                            @if (item.Status == CourseRequestStatus.Saved || 
                                                 item.Status == CourseRequestStatus.Canceled || 
                                                 item.Status == CourseRequestStatus.Rejected)
                                            {
                                                if (Model.ParentLinkStatus == "Linked")
                                                {
                                                    <form asp-action="SendCourseRequest" asp-controller="StudentFamily" method="post" class="d-inline">
                                                        <input type="hidden" name="CourseRequestId" value="@item.CourseRequestId" />
                                                        <button type="submit" class="btn btn-outline-primary btn-sm w-100" style="max-width: 120px;">Send Request</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary btn-sm w-100" style="max-width: 120px;" disabled>Not Linked</button>
                                                }
                                            }
                                            else if (item.Status == CourseRequestStatus.Pending || item.Status == CourseRequestStatus.Unpaid)
                                            {
                                                <form asp-action="CancelCourseRequest" asp-controller="StudentFamily" method="post" class="d-inline">
                                                    <input type="hidden" name="CourseRequestId" value="@item.CourseRequestId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" style="max-width: 120px;" onclick="return confirm('Are you sure you want to cancel this request?');">
                                                        Cancel Request
                                                    </button>
                                                </form>
                                            }
                                            else if (item.Status == CourseRequestStatus.Approved)
                                            {
                                                <button class="btn btn-success btn-sm w-100" style="max-width: 120px;">Go to Course</button>
                                            }

                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-end p-3 border-top">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)&keyword=@Model.SearchKeyword&status=@Model.FilterStatus" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?pageNumber=@i&keyword=@Model.SearchKeyword&status=@Model.FilterStatus">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)&keyword=@Model.SearchKeyword&status=@Model.FilterStatus" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>