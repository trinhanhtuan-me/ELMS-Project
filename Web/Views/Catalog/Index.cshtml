@using Domain.Entities
@model List<Application.Dtos.CatalogCourse.CatalogCourseDto>
@{
    ViewData["Title"] = "Explore Courses";
    var keyword = ViewBag.Keyword as string;
    var selectedCats = ViewBag.SelectedCategories as List<int>;
    var selectedLangs = ViewBag.SelectedLanguages as List<string>;
    var selectedLevels = ViewBag.SelectedLevels as List<string>;
    var sortBy = ViewBag.SortBy as string;
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;

    var allCats = ViewBag.AllCategories as List<Category>;
    var allLangs = ViewBag.AllLanguages as List<string>;
    var allLevels = ViewBag.AllLevels as List<string>;
}

<div class="container py-5">
    <form method="GET" action="/Catalog/Index">
        <div class="row">

            <!-- FILTERS -->
            <div class="col-md-3">
                <h5 class="fw-bold mb-4">Filters</h5>

                @if (!string.IsNullOrEmpty(keyword))
                {
                    <input type="hidden" name="keyword" value="@keyword" />
                }

                <!-- Category -->
                <h6 class="fw-bold mt-3 mb-2 small">Category</h6>
                @if (allCats != null)
                {
                    foreach (var cat in allCats)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="categoryIds" value="@cat.Id" id="cat_@cat.Id" @(selectedCats.Contains(cat.Id) ? "checked" : "") onchange="this.form.submit()">
                            <label class="form-check-label text-muted small" for="cat_@cat.Id">@cat.Name</label>
                        </div>
                    }
                }

                <!-- Language -->
                <h6 class="fw-bold mt-4 mb-2 small">Language</h6>
                @if (allLangs != null)
                {
                    foreach (var lang in allLangs)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="languages" value="@lang" id="lang_@lang" @(selectedLangs.Contains(lang) ? "checked" : "") onchange="this.form.submit()">
                            <label class="form-check-label text-muted small" for="lang_@lang">@lang</label>
                        </div>
                    }
                }

                <!-- Level -->
                <h6 class="fw-bold mt-4 mb-2 small">Level</h6>
                @if (allLevels != null)
                {
                    foreach (var lvl in allLevels)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="levels" value="@lvl" id="lvl_@lvl" @(selectedLevels.Contains(lvl) ? "checked" : "") onchange="this.form.submit()">
                            <label class="form-check-label text-muted small" for="lvl_@lvl">@lvl</label>
                        </div>
                    }
                }
            </div>

            <!-- RIGHT COLUMN: COURSES & PAGINATION -->
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Results @(!string.IsNullOrEmpty(keyword) ? $"for \"{keyword}\"" : "")</h5>

                    <!-- Sort -->
                    <div class="d-flex align-items-center">
                        <select name="sortBy" class="form-select form-select-sm border-0 shadow-sm rounded-3" onchange="this.form.submit();">
                            @if (sortBy == "popular")
                            {
                                <option value="popular" selected>Most Popular</option>
                            }
                            else
                            {
                                <option value="popular">Most Popular</option>
                            }
                            @if (sortBy == "newest")
                            {
                                <option value="newest" selected>Newest</option>
                            }
                            else
                            {
                                <option value="newest">Newest</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Course Grid -->
                <div class="row g-4">
                    @if (!Model.Any())
                    {
                        <div class="col-12 text-center py-5 text-muted">No matching courses found.</div>
                    }
                    @foreach (var course in Model)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                <img src="@(course.Thumbnail)" class="card-img-top" style="height: 160px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <h6 class="fw-bold mb-2">@course.Title</h6>
                                    <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(course.Description ?? "No description available.")
                                    </p>
                                    <div class="mt-auto text-end">
                                        <a href="/CourseDetail/Index/@course.Id" class="btn btn-outline-primary btn-sm px-4 rounded-pill">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center">

                            <!-- Previous Button -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button type="submit" name="page" value="@(currentPage - 1)" class="page-link" @(currentPage == 1 ? "disabled" : "")>«</button>
                            </li>

                            <!-- Page Numbers -->
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <button type="submit" name="page" value="@i" class="page-link">@i</button>
                                </li>
                            }

                            <!-- Next Button -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button type="submit" name="page" value="@(currentPage + 1)" class="page-link" @(currentPage == totalPages ? "disabled" : "")>»</button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

        </div>
    </form>
</div>