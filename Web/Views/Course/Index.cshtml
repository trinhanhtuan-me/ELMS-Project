@model IEnumerable<Domain.Entities.Course>
@{
    ViewData["Title"] = "Quản lý khóa học";
}

@section Styles {
    <link rel="stylesheet" href="~/css/course.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">Quản lý khóa học</h1>
    <button class="btn btn-primary-blue" data-bs-toggle="modal" data-bs-target="#createCourseModal">
        + Thêm khóa học mới
    </button>
</div>

<div class="filters-bar">
    <div>
        Show 
        <select class="filter-select">
            <option>10</option>
            <option>20</option>
        </select> 
        Entries
    </div>
    <div class="search-bar">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search records">
    </div>
</div>

<div class="card-table-wrapper">
    <table class="custom-table">
        <thead>
            <tr>
                <th style="width: 10%;">Hình ảnh</th>
                <th style="width: 35%;">Tên khóa học & Cấp độ</th>
                <th style="width: 20%;">Ngôn ngữ</th>
                <th style="width: 15%;">Trạng thái</th>
                <th style="width: 20%;" class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                        <i class="fa fa-folder-open-o" style="font-size: 2rem; color: #a3aed1;"></i>
                        <p class="mt-2">Chưa có khóa học nào. Hãy thêm mới!</p>
                    </td>
                </tr>
            }
            else
            {
                foreach (var course in Model)
                {
                    <tr>
                        <!-- Cột 1: Hình ảnh -->
                        <td>
                            <div class="img-wrap">
                                @if (!string.IsNullOrEmpty(course.Thumbnail))
                                {
                                    <img src="@course.Thumbnail" alt="Thumbnail">
                                }
                                else
                                {
                                    <i class="fa fa-picture-o" style="color: #c4ccff; font-size: 1.2rem;"></i>
                                }
                            </div>
                        </td>

                        <!-- Cột 2: Tên & Cấp độ -->
                        <td>
                            <div class="course-title">@course.Title</div>
                            <div class="course-subtitle">
                                <i class="fa fa-check-circle" style="color: #5b72ff;"></i> @course.Level
                            </div>
                        </td>

                        <!-- Cột 3: Ngôn ngữ -->
                        <td>
                            <div class="stat-item d-flex align-items-center gap-2">
                                <div style="width: 8px; height: 8px; background: #05cd99; border-radius: 2px;"></div>
                                @course.Language
                            </div>
                        </td>

                        <!-- Cột 4: Trạng thái Active / Draft -->
                        <td>
                            <span class="status-badge @(course.Status == Domain.Enums.CourseStatus.Draft ? "status-draft" : "status-active")">
                                @(course.Status == Domain.Enums.CourseStatus.Draft ? "Draft" : "Active")
                            </span>
                        </td>
                        
                        <!-- Cột 5: Thao tác (Sửa/Xóa) -->
                        <td class="text-end">
                            <button class="action-btn" title="Sửa khóa học">
                                <i class="fa fa-pencil"></i>
                            </button>
                            <button class="action-btn text-danger" title="Xóa khóa học">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<div class="pagination-area">
    <div>
        Show 1 to @(Model.Count()) of @(Model.Count()) entries
    </div>
    <div class="pagination-controls">
        <a href="#" class="page-btn"><i class="fa fa-angle-left"></i></a>
        <a href="#" class="page-btn">1</a>
        <a href="#" class="page-btn">2</a>
        <a href="#" class="page-btn active">3</a>
        <a href="#" class="page-btn">4</a>
        <a href="#" class="page-btn"><i class="fa fa-angle-right"></i></a>
    </div>
</div>

<!-- Modal Create Course -->
<div class="modal fade" id="createCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header border-0 pb-0" style="background-color: #ffffff;">
                <div>
                    <h5 class="modal-title fw-bold mb-1" style="color: #2b3674; font-size: 1.25rem;">Tạo khóa học mới</h5>
                    <p class="text-muted small mb-0">Điền thông tin cơ bản để bắt đầu khóa học của bạn.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="align-self: flex-start; margin-top: 0.5rem;"></button>
            </div>
            
            <form asp-controller="Course" asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    
                    <!-- 1. Ảnh đại diện -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small" style="color: #2b3674;">Ảnh đại diện (Thumbnail) <span class="text-danger">*</span></label>
                        <input type="file" name="ThumbnailFile" class="form-control" style="border-radius: 8px; border: 1px solid #e0e5f2; padding: 0.6rem;" accept="image/*" required />
                    </div>

                    <!-- 2. Tên khóa học -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small" style="color: #2b3674;">Tên khóa học <span class="text-danger">*</span></label>
                        <input name="Title" type="text" class="form-control" style="border-radius: 8px; border: 1px solid #e0e5f2; padding: 0.6rem;" required placeholder="Ví dụ: Lập trình C# cơ bản" />
                    </div>

                    <!-- 3. Ngôn ngữ -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small" style="color: #2b3674;">Ngôn ngữ <span class="text-danger">*</span></label>
                        <select name="Language" class="form-select" style="border-radius: 8px; border: 1px solid #e0e5f2; padding: 0.6rem;" required>
                            <option value="">-- Chọn ngôn ngữ --</option>
                            <option value="English">English</option>
                            <option value="Vietnamese">Vietnamese</option>
                        </select>
                    </div>
                    
                    <!-- 4. Cấp độ -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small" style="color: #2b3674;">Cấp độ <span class="text-danger">*</span></label>
                        <select name="Level" class="form-select" style="border-radius: 8px; border: 1px solid #e0e5f2; padding: 0.6rem;" required>
                            <option value="">-- Chọn cấp độ --</option>
                            <option value="Beginner">Người mới bắt đầu</option>
                            <option value="Intermediate">Trung bình</option>
                            <option value="Advanced">Nâng cao</option>
                        </select>
                    </div>

                    <!-- 5. Danh mục -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small" style="color: #2b3674;">Danh mục <span class="text-danger">*</span></label>
                        <select name="CategoryId" class="form-select" style="border-radius: 8px; border: 1px solid #e0e5f2; padding: 0.6rem;" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 6. Mô tả -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold small" style="color: #2b3674;">Mô tả ngắn gọn</label>
                        <textarea name="Description" class="form-control" style="border-radius: 8px; border: 1px solid #e0e5f2; padding: 0.6rem;" rows="3" placeholder="Giới thiệu nhanh về khóa học này..."></textarea>
                    </div>
                </div>
                
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 8px; font-weight: 500; border: 1px solid #e0e5f2;" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn-primary-blue px-4 ms-2">
                        Lưu khóa học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
