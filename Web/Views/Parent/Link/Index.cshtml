@using Domain.Enums;
@model Application.Common.PaginatedList<Application.Dtos.ParentLink.ParentLinkRequestResponseDto>

@{
    Layout = "~/Views/Parent/_Layout.cshtml";
    ViewData["Title"] = Localizer["page_title"];
    var currentStatus = ViewBag.CurrentStatus as string ?? "Pending";
    
    // Tính toán phân trang
    int currentPage = int.TryParse(Context.Request.Query["pageNumber"].ToString(), out var p) && p > 0 ? p : 1;
    int pageSize = 6;
    int totalItems = Model.Total;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    if (totalPages < 1) totalPages = 1;
}

<div>
    <!-- Header -->
    <div class="mb-8 border-b border-slate-100 pb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-user-group text-red-600"></i>
            @Localizer["page_title"]
        </h1>
        <p class="text-sm text-slate-500 mt-1">@Localizer["page_description"]</p>
    </div>

    <!-- Validation Summary (Tailwind styling) -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-xl flex gap-3 items-start">
            <i class="fa-solid fa-triangle-exclamation text-rose-500 shrink-0 mt-0.5 text-base"></i>
            <div>
                <div asp-validation-summary="All" class="font-medium list-disc pl-2"></div>
            </div>
        </div>
    }

    <!-- Filter Tabs (Tailwind styling) -->
    <div class="mb-8 border-b border-slate-200">
        <nav class="-mb-px flex gap-6" aria-label="Tabs">
            <a href="@Url.Action("Index", "ParentLink", new { status = "Approved" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Approved" ? "border-emerald-500 text-emerald-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-circle-check mr-1.5"></i>
                @Localizer["tab_linked"]
            </a>
            
            <a href="@Url.Action("Index", "ParentLink", new { status = "Pending" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Pending" ? "border-amber-500 text-amber-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-clock mr-1.5"></i>
                @Localizer["tab_pending"]
            </a>

            <a href="@Url.Action("Index", "ParentLink", new { status = "Rejected" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Rejected" ? "border-rose-500 text-rose-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-circle-xmark mr-1.5"></i>
                @Localizer["tab_rejected"]
            </a>
            
            <a href="@Url.Action("Index", "ParentLink", new { status = "Unlink" })" 
               class="shrink-0 border-b-2 px-1 pb-4 text-sm font-medium transition-all @(currentStatus == "Unlink" ? "border-slate-500 text-slate-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700")">
                <i class="fa-solid fa-user-xmark mr-1.5"></i>
                @Localizer["tab_unlinked"]
            </a>
        </nav>
    </div>

    <!-- Student Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        @if (Model == null || Model.Data == null || !Model.Data.Any())
        {
            <div class="col-span-full py-16 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                <div class="text-slate-300 text-4xl mb-3">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <h3 class="text-lg font-semibold text-slate-700">@Localizer["no_data_title"]</h3>
                <p class="text-sm text-slate-500 mt-1">@Localizer["no_data_description"]</p>
            </div>
        }
        else
        {
            foreach (var req in Model.Data)
            {
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow p-5 flex flex-col justify-between">
                    <div>
                        <!-- Header card: Avatar + Name -->
                        <div class="flex items-center gap-4 mb-4">
                            <div class="h-12 w-12 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 text-lg">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <div class="min-w-0">
                                <h3 class="font-bold text-slate-800 truncate" title="@req.StudentName">@req.StudentName</h3>
                                <p class="text-xs text-slate-400 font-mono truncate">@Localizer["student_id"]: @req.StudentId.ToString().Substring(0, 8)...</p>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="flex items-center gap-2 text-sm text-slate-600 mb-3">
                            <i class="fa-solid fa-envelope text-slate-400"></i>
                            <span class="truncate">@req.StudentEmail</span>
                        </div>

                        <!-- Status Badge -->
                        <div class="mb-4">
                            @if (req.Status == ParentLinkRequestStatus.Approved)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                    @Localizer["status_active"]
                                </span>
                            }
                            else if (req.Status == ParentLinkRequestStatus.Pending)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">
                                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                    @Localizer["status_pending"]
                                </span>
                            }
                            else if (req.Status == ParentLinkRequestStatus.Rejected)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-100">
                                    <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                                    @Localizer["status_rejected"]
                                </span>
                            }
                            else if (req.Status == ParentLinkRequestStatus.Canceled)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                    @Localizer["status_canceled"]
                                </span>
                            }
                            else if (req.Status == ParentLinkRequestStatus.Unlink)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                    @Localizer["status_unlinked"]
                                </span>
                            }
                        </div>

                        <!-- Date Info -->
                        <div class="border-t border-slate-100 pt-3 mb-4 space-y-1.5 text-xs text-slate-500">
                            <div class="flex justify-between">
                                <span>@Localizer["date_requested"]:</span>
                                <span class="font-medium text-slate-700">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (req.DecidedAt.HasValue)
                            {
                                <div class="flex justify-between">
                                    <span>@Localizer["date_decided"]:</span>
                                    <span class="font-medium text-slate-700">@req.DecidedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                        </div>

                        <!-- Notes/Comments -->
                        @if (!string.IsNullOrEmpty(req.Note))
                        {
                            <div class="bg-slate-50 border border-slate-100 rounded-lg p-2.5 mb-4 text-xs text-slate-600 flex gap-2">
                                <i class="fa-solid fa-comment-dots text-slate-400 shrink-0 mt-0.5"></i>
                                <span>@req.Note</span>
                            </div>
                        }
                    </div>

                    <!-- Actions -->
                    <div>
                        @if (req.Status == ParentLinkRequestStatus.Pending)
                        {
                            <div class="flex gap-3">
                                <!-- Trigger Approve Modal -->
                                <button type="button" onclick="openApproveModal('@req.RequestId', '@req.StudentName')" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-1.5">
                                    <i class="fa-solid fa-check"></i>
                                    @Localizer["btn_approve"]
                                </button>
                                <!-- Trigger Reject Modal -->
                                <button type="button" onclick="openRejectModal('@req.RequestId')" class="w-full border border-rose-200 hover:bg-rose-50 text-rose-600 font-semibold text-xs py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-1.5">
                                    <i class="fa-solid fa-xmark"></i>
                                    @Localizer["btn_reject"]
                                </button>
                            </div>
                        }
                        else if (req.Status == ParentLinkRequestStatus.Approved)
                        {
                            <!-- Trigger Unlink Modal -->
                            <button type="button" onclick="openUnlinkModal('@req.StudentId', '@req.StudentName')" class="w-full bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-link-slash"></i>
                                @Localizer["btn_unlink"]
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Phân trang (Pagination) -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-slate-200 bg-white px-4 py-3 sm:px-6 mt-8 rounded-xl shadow-sm">
            <div class="flex flex-1 justify-between sm:hidden">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Index", "ParentLink", new { status = currentStatus, pageNumber = currentPage - 1 })" 
                       class="inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                        @Localizer["btn_prev"]
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-400 cursor-not-allowed">
                        @Localizer["btn_prev"]
                    </span>
                }
                
                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Index", "ParentLink", new { status = currentStatus, pageNumber = currentPage + 1 })" 
                       class="ml-3 inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                        @Localizer["btn_next"]
                    </a>
                }
                else
                {
                    <span class="ml-3 inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-400 cursor-not-allowed">
                        @Localizer["btn_next"]
                    </span>
                }
            </div>
            
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-700">
                        @string.Format(Localizer["results_info"], ((currentPage - 1) * pageSize) + 1, Math.Min(currentPage * pageSize, totalItems), totalItems)
                    </p>
                </div>
                
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        <!-- Nút Trước -->
                        @if (currentPage > 1)
                        {
                            <a href="@Url.Action("Index", "ParentLink", new { status = currentStatus, pageNumber = currentPage - 1 })" 
                               class="inline-flex items-center rounded-l-md px-3 py-2 text-slate-400 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fa-solid fa-chevron-left text-xs"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-l-md px-3 py-2 text-slate-300 ring-1 ring-inset ring-slate-200 bg-slate-50 cursor-not-allowed">
                                <i class="fa-solid fa-chevron-left text-xs"></i>
                            </span>
                        }

                        <!-- Các trang số -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == currentPage)
                            {
                                <span class="relative z-10 inline-flex items-center bg-red-600 px-4.5 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 px-4">
                                    @i
                                </span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", "ParentLink", new { status = currentStatus, pageNumber = i })" 
                                   class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0">
                                    @i
                                </a>
                            }
                        }

                        <!-- Nút Sau -->
                        @if (currentPage < totalPages)
                        {
                            <a href="@Url.Action("Index", "ParentLink", new { status = currentStatus, pageNumber = currentPage + 1 })" 
                               class="inline-flex items-center rounded-r-md px-3 py-2 text-slate-400 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fa-solid fa-chevron-right text-xs"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-r-md px-3 py-2 text-slate-300 ring-1 ring-inset ring-slate-200 bg-slate-50 cursor-not-allowed">
                                <i class="fa-solid fa-chevron-right text-xs"></i>
                            </span>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

<!-- Custom Modals -->
<partial name="~/Views/Parent/Link/_Modals.cshtml" />

@section Scripts {
    <script>
        // Helper to open modal with transition
        function showModal(modalId) {
            var modal = document.getElementById(modalId);
            var card = modal.querySelector('.modal-card');
            
            // Show backdrop
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');
            
            // Scale and fade card in
            card.classList.remove('scale-95', 'opacity-0');
            card.classList.add('scale-100', 'opacity-100');
        }

        // Helper to close modal with transition
        function hideModal(modalId) {
            var modal = document.getElementById(modalId);
            var card = modal.querySelector('.modal-card');
            
            // Scale and fade card out
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            
            // Hide backdrop
            modal.classList.remove('opacity-100', 'pointer-events-auto');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        // Modal Approve
        function openApproveModal(requestId, studentName) {
            document.getElementById('approveRequestId').value = requestId;
            document.getElementById('approveStudentName').textContent = studentName;
            showModal('approveModal');
        }
        function closeApproveModal() {
            hideModal('approveModal');
        }

        // Modal Reject
        function openRejectModal(requestId) {
            document.getElementById('rejectRequestId').value = requestId;
            document.getElementById('rejectNote').value = '';
            document.getElementById('rejectNoteError').classList.add('hidden');
            showModal('rejectModal');
        }
        function closeRejectModal() {
            hideModal('rejectModal');
        }
        function validateRejectForm() {
            var note = document.getElementById('rejectNote').value.trim();
            if (note === "") {
                document.getElementById('rejectNoteError').classList.remove('hidden');
                return false;
            }
            return true;
        }

        // Modal Unlink
        function openUnlinkModal(studentId, studentName) {
            document.getElementById('unlinkStudentId').value = studentId;
            document.getElementById('unlinkNote').value = '';
            document.getElementById('unlinkNoteError').classList.add('hidden');
            showModal('unlinkModal');
        }
        function closeUnlinkModal() {
            hideModal('unlinkModal');
        }
        function validateUnlinkForm() {
            var note = document.getElementById('unlinkNote').value.trim();
            if (note === "") {
                document.getElementById('unlinkNoteError').classList.remove('hidden');
                return false;
            }
            return true;
        }
    </script>
}


