@{
    Layout = "_ModuleContentLayout";
    ViewData["Title"] = "Manage Quiz Questions";
    var quizId = ViewBag.QuizId;
    var courseId = ViewBag.CourseId;
    var moduleId = ViewBag.ModuleId;
    var moduleItemId = ViewBag.ModuleItemId;
}

<div x-data="quizQuestions('@quizId')">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-list-ol text-blue-500 mr-3"></i> Manage Questions
            </h2>
            <p class="text-sm text-gray-500 mt-1">
                Quiz ID: @quizId
            </p>
        </div>
        
        <div class="flex gap-2">
            <a href="/Quiz/UpdateQuiz?lessonId=@moduleItemId" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors flex items-center text-sm font-medium">
                <i class="fas fa-arrow-left mr-2"></i> Back to Quiz
            </a>
            <button type="button" @@click="openModal()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center shadow-sm text-sm font-medium">
                <i class="fas fa-plus mr-2"></i> Add Question
            </button>
        </div>
    </div>

    <!-- Question List -->
    <div class="space-y-4">
        <template x-if="questions.length === 0">
            <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-xl p-10 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-200 text-gray-400 mb-4">
                    <i class="fas fa-folder-open text-2xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-1">No questions yet</h3>
                <p class="text-gray-500 mb-4">This quiz has no questions. Get started by adding a new question.</p>
                <button type="button" @@click="openModal()" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    <i class="fas fa-plus mr-2"></i> Add your first question
                </button>
            </div>
        </template>
        
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-sm font-semibold text-gray-700">
                            <th class="p-4 text-center w-16">No.</th>
                            <th class="p-4">Question</th>
                            <th class="p-4 w-64">Correct Answer</th>
                            <th class="p-4 text-center w-28">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(q, index) in questions" :key="q.questionId || q.id">
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                <td class="p-4 text-center font-medium text-gray-500">
                                    <span class="inline-block px-2 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded" x-text="index + 1"></span>
                                </td>
                                <td class="p-4">
                                    <div class="text-gray-800 font-medium whitespace-pre-wrap" x-text="q.content"></div>
                                    <template x-if="q.explanation">
                                        <div class="mt-2 text-xs text-gray-500 flex items-start gap-1">
                                            <i class="fas fa-lightbulb text-yellow-500 mt-0.5"></i> 
                                            <span x-text="q.explanation"></span>
                                        </div>
                                    </template>
                                </td>
                                <td class="p-4 text-sm">
                                    <template x-for="opt in (q.options || q.quizOptions)" :key="opt.id">
                                        <template x-if="opt.isCorrect">
                                            <div class="flex items-start gap-1.5 text-green-700 bg-green-50 px-2 py-1.5 rounded border border-green-100 mb-1">
                                                <i class="fas fa-check-circle mt-0.5"></i>
                                                <span class="font-medium line-clamp-2" x-text="opt.content"></span>
                                            </div>
                                        </template>
                                    </template>
                                    <div class="text-xs text-gray-400 mt-1">Total: <span x-text="(q.options || q.quizOptions)?.length || 0"></span> options</div>
                                </td>
                                <td class="p-4">
                                    <div class="flex gap-2 justify-center">
                                        <button type="button" @@click="editQuestion(q)" class="w-8 h-8 flex items-center justify-center bg-gray-100 text-gray-600 rounded-lg hover:bg-blue-50 hover:text-blue-600 transition-colors" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" @@click="deleteQuestion(q.questionId || q.id)" class="w-8 h-8 flex items-center justify-center bg-gray-100 text-gray-600 rounded-lg hover:bg-red-50 hover:text-red-500 transition-colors" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Form -->
    <div x-show="isModalOpen" class="fixed inset-0 z-50 overflow-y-auto" style="display: none;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div x-show="isModalOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @@click="closeModal()"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            
            <div x-show="isModalOpen" x-transition class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-3xl sm:w-full">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <h3 class="text-xl font-bold text-gray-900 mb-4 border-b pb-2" id="modal-title" x-text="isEditMode ? 'Update Question' : 'Add New Question'"></h3>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Question <span class="text-red-500">*</span></label>
                            <textarea id="questionContentEditor" x-model="formData.content" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Explanation (Optional)</label>
                            <textarea x-model="formData.explanation" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Explain why this answer is correct..."></textarea>
                        </div>
                        
                        <div class="mt-6 border-t pt-4">
                            <div class="flex justify-between items-center mb-4">
                                <label class="block text-sm font-semibold text-gray-700">Answer Options <span class="text-red-500">*</span></label>
                                <button type="button" @@click="addOption()" class="text-sm px-3 py-1 bg-green-50 text-green-600 rounded-md hover:bg-green-100 font-medium flex items-center transition-colors">
                                    <i class="fas fa-plus mr-1"></i> Add Option
                                </button>
                            </div>
                            
                            <div class="space-y-3">
                                <template x-for="(opt, idx) in formData.options" :key="idx">
                                    <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                                        <div class="mt-2 flex items-center justify-center">
                                            <input type="radio" name="correctOption" :value="idx" x-model="correctOptionIndex" class="w-5 h-5 text-blue-600 border-gray-300 focus:ring-blue-500 cursor-pointer">
                                        </div>
                                        <div class="flex-1">
                                            <input type="text" x-model="opt.content" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" placeholder="Enter option..." required>
                                        </div>
                                        <button type="button" @@click="removeOption(idx)" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors" title="Delete Option" x-show="formData.options.length > 2">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </template>
                            </div>
                            <p class="text-xs text-gray-500 mt-2 italic">Check the circle to select the correct answer. There must be at least 2 options and 1 correct answer.</p>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 sm:px-6 flex justify-end gap-3">
                    <button type="button" @@click="closeModal()" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">Cancel</button>
                    <button type="button" @@click="saveQuestion()" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm flex items-center">
                        <i class="fas fa-save mr-2"></i> <span x-text="isEditMode ? 'Update' : 'Save'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('quizQuestions', (quizId) => ({
                quizId: quizId,
                questions: [],
                isModalOpen: false,
                isEditMode: false,
                currentQuestionId: null,
                correctOptionIndex: null,
                formData: {
                    content: '',
                    explanation: '',
                    options: []
                },

                async init() {
                    await this.loadQuestions();
                },

                async loadQuestions() {
                    try {
                        const res = await fetch(`/api/QuizQuestionApi/quiz/${this.quizId}`);
                        if (res.ok) {
                            this.questions = await res.json();
                        }
                    } catch (error) {
                        console.error("Error loading questions", error);
                    }
                },



                openModal() {
                    this.isEditMode = false;
                    this.currentQuestionId = null;
                    this.formData = {
                        content: '',
                        explanation: '',
                        options: [
                            { content: '', isCorrect: false },
                            { content: '', isCorrect: false }
                        ]
                    };
                    this.correctOptionIndex = null;
                    this.isModalOpen = true;
                },

                async editQuestion(q) {
                    this.isEditMode = true;
                    // Try to fetch full question details for editing if needed, or use existing data
                    try {
                        const res = await fetch(`/api/QuizQuestionApi/${q.questionId || q.id}`);
                        if (res.ok) {
                            const data = await res.json();
                            this.currentQuestionId = data.questionId || data.id;
                            this.formData = {
                                content: data.content,
                                explanation: data.explanation || '',
                                options: data.options.map(o => ({
                                    id: o.id,
                                    content: o.content,
                                    isCorrect: o.isCorrect
                                }))
                            };
                            
                            // Find correct option index
                            this.correctOptionIndex = this.formData.options.findIndex(o => o.isCorrect);
                            if(this.correctOptionIndex === -1) this.correctOptionIndex = null;
                            
                            this.isModalOpen = true;
                        }
                    } catch (error) {
                        alert("Could not load question information.");
                    }
                },

                closeModal() {
                    this.isModalOpen = false;
                },

                addOption() {
                    this.formData.options.push({ content: '', isCorrect: false });
                },

                removeOption(index) {
                    if (this.formData.options.length <= 2) {
                        alert("There must be at least 2 options.");
                        return;
                    }
                    this.formData.options.splice(index, 1);
                    if (this.correctOptionIndex === index) {
                        this.correctOptionIndex = null;
                    } else if (this.correctOptionIndex > index) {
                        this.correctOptionIndex--;
                    }
                },

                async saveQuestion() {

                    if (!this.formData.content || this.formData.content.trim() === '') {
                        alert("Please enter the question content.");
                        return;
                    }

                    if (this.correctOptionIndex === null || this.correctOptionIndex === undefined) {
                        alert("Please select 1 correct answer.");
                        return;
                    }

                    let hasEmptyOption = false;
                    this.formData.options.forEach((opt, idx) => {
                        if (!opt.content || opt.content.trim() === '') hasEmptyOption = true;
                        opt.isCorrect = (idx == this.correctOptionIndex);
                    });

                    if (hasEmptyOption) {
                        alert("Please fill in all options.");
                        return;
                    }

                    // For the API payload, we provide CourseId/ModuleId etc as empty Guid just in case
                    const payload = {
                        quizId: this.quizId,
                        courseId: "00000000-0000-0000-0000-000000000000",
                        moduleId: "00000000-0000-0000-0000-000000000000",
                        moduleItemId: "00000000-0000-0000-0000-000000000000",
                        content: this.formData.content,
                        explanation: this.formData.explanation,
                        options: this.formData.options
                    };

                    let url = '/api/QuizQuestionApi';
                    let method = 'POST';

                    if (this.isEditMode) {
                        url = `/api/QuizQuestionApi/${this.currentQuestionId}`;
                        method = 'PUT';
                        payload.questionId = this.currentQuestionId;
                    }

                    try {
                        const res = await fetch(url, {
                            method: method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        if (res.ok) {
                            this.closeModal();
                            await this.loadQuestions();
                            // Optional: Show toast notification here
                        } else {
                            const errorData = await res.json();
                            alert(errorData.message || "An error occurred while saving the question.");
                        }
                    } catch (error) {
                        alert("Connection error.");
                    }
                },

                async deleteQuestion(id) {
                    if (confirm("Are you sure you want to delete this question?")) {
                        try {
                            const res = await fetch(`/api/QuizQuestionApi/${id}?quizId=${this.quizId}`, {
                                method: 'DELETE'
                            });
                            
                            if (res.ok) {
                                await this.loadQuestions();
                            } else {
                                alert("Could not delete the question.");
                            }
                        } catch (error) {
                            alert("Connection error.");
                        }
                    }
                }
            }));
        });
    </script>
}
