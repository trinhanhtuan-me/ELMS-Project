@model Application.Dtos.StudentProfile.StudentProfileVm

@{
    ViewData["Title"] = "Personal Information";
}

<div class="container py-5">
    <form asp-action="Update" asp-controller="StudentProfile" method="post" enctype="multipart/form-data">
        <div class="row gx-5">

            <!-- Left Column: Avatar Section -->
            <div class="col-md-4 col-lg-3 text-center mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-column align-items-center justify-content-center">
                    <div class="position-relative mb-3">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" id="avatarPreview" class="rounded-circle object-fit-cover" style="width: 180px; height: 180px; border: 4px solid #f8f9fa;" />
                        }
                        else
                        {
                            <!-- Default Avatar Placeholder -->
                            <div id="avatarPlaceholder" class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white mx-auto" style="width: 180px; height: 180px; font-size: 5rem;">
                                <i class="fas fa-user"></i>
                            </div>
                            <!-- Hidden img tag for live preview -->
                            <img src="#" id="avatarPreview" class="rounded-circle object-fit-cover d-none" style="width: 180px; height: 180px; border: 4px solid #f8f9fa;" />
                        }
                    </div>

                    <label for="AvatarFile" class="text-primary fw-bold mb-1" style="cursor: pointer; text-decoration: none;">Change Avatar</label>
                    <input type="file" id="AvatarFile" name="AvatarFile" class="d-none" accept="image/*" onchange="previewAvatar(event)">

                    <small class="text-muted">Max 5MB</small>
                </div>
            </div>

            <!-- Right Column: Profile Details -->
            <div class="col-md-8 col-lg-9">
                <h4 class="fw-bold mb-4 text-uppercase">Personal Information</h4>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Username</label>
                        <input type="text" class="form-control bg-light" value="@Model.Username" readonly disabled>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Full Name</label>
                        <input type="text" asp-for="FullName" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Role</label>
                        <input type="text" class="form-control bg-light" value="Student" readonly disabled>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Email</label>
                        <input type="email" class="form-control bg-light" value="@Model.Email" readonly disabled>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Phone Number</label>
                        <input type="text" asp-for="Phone" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Date of Birth</label>
                        <input type="date" asp-for="DateOfBirth" class="form-control">
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Select...</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Address</label>
                        <input type="text" asp-for="Address" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Grade / Class</label>
                        <input type="text" asp-for="GradeLevel" class="form-control">
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label fw-bold text-muted small">School / Institution</label>
                        <input type="text" asp-for="Institution" class="form-control">
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Update Profile</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Function to handle live image preview
        function previewAvatar(event) {
            var input = event.target;
            if (input.files && input.files[0]) {
                // Check file size (5MB = 5 * 1024 * 1024 bytes)
                if (input.files[0].size > 5242880) {
                    alert("File size exceeds 5MB. Please choose a smaller image.");
                    input.value = ""; // Clear the selected file
                    return;
                }

                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('avatarPreview');
                    var placeholder = document.getElementById('avatarPlaceholder');

                    if (placeholder) {
                        placeholder.classList.add('d-none');
                        preview.classList.remove('d-none');
                    }
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}