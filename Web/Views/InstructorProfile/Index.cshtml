@model Application.Dtos.InstructorProfile.InstructorProfileVm
@{
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
    ViewData["Title"] = "Instructor Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/course.css" asp-append-version="true" />
    <style>
        .profile-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid #e2e8f0;
            padding: 2rem;
            margin-bottom: 2rem;
        }
        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 0.75rem 1rem;
            color: #1e293b;
        }
        .form-control:focus, .form-select:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
        .btn-primary {
            background-color: #4f46e5;
            border-color: #4f46e5;
            border-radius: 8px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
        }
        .btn-primary:hover {
            background-color: #4338ca;
            border-color: #4338ca;
        }
    </style>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fa fa-user-circle-o text-primary me-2"></i> Instructor Profile</h2>
            <p class="text-muted mb-0">Update your personal information and preferences.</p>
        </div>
    </div>

    @if (TempData["SuccessToast"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessToast"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorToast"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorToast"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="profile-card text-center">
                <img src="https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(Model.FullName ?? Model.Username ?? "Instructor"))&background=4f46e5&color=fff&size=160" 
                     alt="Avatar" class="rounded-circle mb-3 border border-3 border-light shadow-sm" style="width: 150px; height: 150px; object-fit: cover;" />
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted mb-0">@Model.Email</p>
                <div class="mt-3">
                    <span class="badge bg-primary">Instructor</span>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="profile-card">
                <form asp-action="Update" asp-controller="InstructorProfile" method="post">
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" class="form-control bg-light" value="@Model.Username" readonly disabled>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" class="form-control bg-light" value="@Model.Email" readonly disabled>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" asp-for="FullName" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone Number</label>
                            <input type="text" asp-for="Phone" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date of Birth</label>
                            <input type="date" asp-for="DateOfBirth" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select Gender...</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-primary px-4"><i class="fa fa-save me-2"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
