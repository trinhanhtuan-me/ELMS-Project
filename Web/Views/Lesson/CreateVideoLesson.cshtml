@model Application.Dtos.Lesson.VideoLessonCreateRequest
@{
    Layout = "_ModuleContentLayout";
    ViewData["Title"] = "Tạo Bài học Video";
    var moduleId = ViewBag.ModuleId;
    var courseId = ViewBag.CourseId;
}

<div>
    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
        <i class="fas fa-video text-blue-500 mr-3"></i> Thêm Bài học Video
    </h2>

    <form action="/Lesson/CreateVideoLesson" method="post" enctype="multipart/form-data" class="space-y-6">
        <input type="hidden" name="CourseId" value="@courseId" />
        <input type="hidden" name="ModuleId" value="@moduleId" />
        
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Tiêu đề bài học <span class="text-red-500">*</span></label>
            <input type="text" name="Title" required
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
                   placeholder="Nhập tiêu đề (VD: Bài 1: Giới thiệu khóa học)" />
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Video File <span class="text-red-500">*</span></label>
            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg hover:border-blue-500 transition-colors bg-gray-50">
                <div class="space-y-1 text-center">
                    <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-3"></i>
                    <div class="flex text-sm text-gray-600 justify-center">
                        <label for="file-upload" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500 px-2 py-1">
                            <span>Tải video lên</span>
                            <input id="file-upload" name="VideoFile" type="file" class="sr-only" accept="video/*" required>
                        </label>
                        <p class="pl-1 py-1">hoặc kéo thả vào đây</p>
                    </div>
                    <p class="text-xs text-gray-500" id="file-name">MP4, WebM, OGG up to 100MB</p>
                </div>
            </div>
            <p class="mt-2 text-xs text-gray-500 italic"><i class="fas fa-info-circle"></i> Thời lượng video sẽ được hệ thống tự động tính toán sau khi tải lên.</p>
        </div>

        <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
            <a href="/Course/Details/@courseId" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                Hủy bỏ
            </a>
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm flex items-center">
                <i class="fas fa-save mr-2"></i> Lưu bài học
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('file-upload').addEventListener('change', function(e) {
            var fileName = e.target.files[0] ? e.target.files[0].name : "MP4, WebM, OGG up to 100MB";
            document.getElementById('file-name').textContent = "Đã chọn: " + fileName;
            document.getElementById('file-name').classList.add("text-blue-600", "font-medium");
        });
    </script>
}
