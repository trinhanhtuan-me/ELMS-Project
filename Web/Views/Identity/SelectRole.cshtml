@model List<string>
@{
    ViewData["Title"] = "Select Your Role";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center text-center mb-5">
        <div class="col-md-8">
            <h2 class="fw-bold">Welcome Back!</h2>
            <p class="text-muted">You have multiple roles associated with your account. Please select your workspace for this session:</p>
        </div>
    </div>

    <div class="row justify-content-center">
        @foreach (var role in Model)
        {
            <div class="col-md-5 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm text-center py-4 hover-shadow" style="transition: transform 0.3s;">
                    <div class="card-body">
                        @if (role.ToLower().Contains("student"))
                        {
                            <h3 class="text-primary mb-3"><i class="fa fa-graduation-cap fa-2x"></i></h3>
                            <h4 class="card-title fw-bold">Student</h4>
                            <p class="card-text text-muted mb-4">Enter your learning space, view lectures, and complete assignments.</p>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary px-4 stretched-link">Continue</a>
                        }
                        else if (role.ToLower().Contains("parent"))
                        {
                            <h3 class="text-success mb-3"><i class="fa fa-users fa-2x"></i></h3>
                            <h4 class="card-title fw-bold">Parent</h4>
                            <p class="card-text text-muted mb-4">Manage your account and track your children's learning progress.</p>
                            <a href="@Url.Action("Index", "ParentLink")" class="btn btn-outline-success px-4 stretched-link">Continue</a>
                        }
                        else if (role.ToLower().Contains("instructor") || role.ToLower().Contains("teacher"))
                        {
                            <h3 class="text-warning mb-3"><i class="fa fa-briefcase fa-2x"></i></h3>
                            <h4 class="card-title fw-bold">Instructor</h4>
                            <p class="card-text text-muted mb-4">Enter the dashboard to manage and publish your courses.</p>
                            <a href="@Url.Action("????", "????")" class="btn btn-outline-warning px-4 stretched-link">Continue</a>
                        }
                        else if (role.ToLower().Contains("manager"))
                        {
                            <h3 class="text-danger mb-3"><i class="fa fa-cogs fa-2x"></i></h3>
                            <h4 class="card-title fw-bold">Manager</h4>
                            <p class="card-text text-muted mb-4">Access the ELMS system administration and management area.</p>
                            <a href="@Url.Action("Dashboard", "Manager")" class="btn btn-outline-danger px-4 stretched-link">Continue</a>
                        }
                        else if (role.ToLower().Contains("admin"))
                        {
                            <h3 class="text-dark mb-3"><i class="fa fa-shield fa-2x"></i></h3>
                            <h4 class="card-title fw-bold">System Admin</h4>
                            <p class="card-text text-muted mb-4">Master control for system configurations, accounts, and security.</p>
                            <a href="@Url.Action("????", "????")" class="btn btn-outline-dark px-4 stretched-link">Continue</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }
</style>