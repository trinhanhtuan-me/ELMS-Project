@model List<Application.Dtos.ParentProgress.ChildSummaryDto>

@{
    Layout = "~/Views/Parent/_Layout.cshtml";
    ViewData["Title"] = Localizer["progress_dashboard_title"] ?? "Theo Dõi Tiến Độ Học Tập Của Con";
}

<div class="space-y-8">
    <!-- Header Title -->
    <div>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">@Localizer["progress_dashboard_title"]</h1>
        <p class="text-sm text-slate-500 mt-1">@Localizer["progress_dashboard_subtitle"]</p>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center max-w-xl mx-auto my-8 shadow-sm">
            <div class="h-16 w-16 bg-slate-50 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-slate-100">
                <i class="fa-solid fa-users-slash text-2xl"></i>
            </div>
            <h3 class="text-slate-700 font-bold text-base">@Localizer["progress_no_children_title"]</h3>
            <p class="text-slate-400 text-xs mt-1 leading-relaxed">@Localizer["progress_no_children_desc"]</p>
            <a href="@Url.Action("Index", "ParentLink")" class="inline-flex items-center gap-1.5 px-4.5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition duration-150 shadow-sm mt-6">
                <i class="fa-solid fa-link"></i>
                @Localizer["progress_link_child_now"]
            </a>
        </div>
    }
    else
    {
        <!-- Children Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var child in Model)
            {
                <div class="bg-white rounded-2xl border border-slate-150 p-6 shadow-sm flex flex-col justify-between hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden group">
                    <div>
                        <!-- Header / Info -->
                        <div class="flex items-center gap-3.5 mb-5">
                            <div class="h-12 w-12 bg-indigo-50 text-indigo-650 rounded-full flex items-center justify-center font-extrabold text-sm shrink-0 border border-indigo-100/50 shadow-sm">
                                @(string.IsNullOrEmpty(child.StudentName) ? "ST" : child.StudentName.Substring(0, Math.Min(2, child.StudentName.Length)).ToUpper())
                            </div>
                            <div class="overflow-hidden">
                                <h4 class="text-slate-800 font-bold text-sm tracking-tight leading-snug">@child.StudentName</h4>
                                <p class="text-slate-400 text-xs mt-0.5 truncate">@child.StudentEmail</p>
                            </div>
                        </div>

                        <!-- Statistics Grid -->
                        <div class="grid grid-cols-3 gap-3 border-t border-b border-slate-100 py-4 my-4">
                            <div class="text-center">
                                <span class="text-slate-400 text-[10px] uppercase tracking-wider font-extrabold block">@Localizer["progress_stat_enrolled"]</span>
                                <span class="text-slate-800 font-extrabold text-base block mt-0.5">@child.EnrolledCoursesCount</span>
                            </div>
                            <div class="text-center border-l border-r border-slate-100 px-1">
                                <span class="text-slate-400 text-[10px] uppercase tracking-wider font-extrabold block">@Localizer["progress_stat_completed"]</span>
                                <span class="text-emerald-600 font-extrabold text-base block mt-0.5">@child.CompletedCoursesCount</span>
                            </div>
                            <div class="text-center">
                                <span class="text-slate-400 text-[10px] uppercase tracking-wider font-extrabold block">@Localizer["progress_stat_avg"]</span>
                                <span class="text-indigo-600 font-extrabold text-base block mt-0.5">@child.AverageProgressPct%</span>
                            </div>
                        </div>

                        <!-- Progress Bar Section -->
                        <div class="space-y-1.5 mt-4">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-400 font-semibold">@Localizer["progress_average_progress"]</span>
                                <span class="text-slate-700 font-bold">@child.AverageProgressPct%</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2">
                                <div class="bg-indigo-600 h-2 rounded-full transition-all duration-500" style="width: @child.AverageProgressPct%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Link -->
                    <div class="mt-6 border-t border-slate-100 pt-4">
                        <a href="@Url.Action("ChildCourses", "ParentProgress", new { studentId = child.StudentId })" 
                           class="w-full py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-bold rounded-xl transition duration-150 flex items-center justify-center gap-1.5 border border-slate-150/50">
                            <i class="fa-solid fa-chart-line"></i>
                            @Localizer["progress_btn_view_courses"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
