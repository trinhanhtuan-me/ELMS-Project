@using System.Security.Claims
@{
    string fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Instructor";
    string profilePicture = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(fullName)}&background=4f46e5&color=fff&size=100";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Instructor Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-container">
        
        <!-- Sidebar -->
        <aside class="sidebar" style="background-color: white; border-right: 1px solid #e2e8f0;">
            <div class="sidebar-header" style="padding: 20px; text-align: center; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px;">
                <a href="/Course/Index" class="logo" style="text-decoration: none; font-size: 1.5rem; font-weight: bold;">
                    <img src="~/Images/views-manager/Icon/ELMS.png" alt="Logo" style="max-height: 40px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline'; this.nextElementSibling.style.color='#4f46e5';">
                    <span style="display:none; color:#4f46e5;">ELMS</span>
                </a>
            </div>

            <nav class="sidebar-nav" style="display: flex; flex-direction: column; gap: 8px; padding: 0 16px;">
              
                
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                }
                <a href="/Course/Index" class="nav-item @(currentController == "Course" ? "active" : "")" style="padding: 12px 16px; color: @(currentController == "Course" ? "white" : "#475569"); background: @(currentController == "Course" ? "#4f46e5" : "transparent"); text-decoration: none; border-radius: 8px; display: flex; align-items: center; gap: 12px; transition: all 0.3s; font-weight: 500;">
                    <i class="fa fa-folder-open-o fa-fw"></i> Course Management
                </a>
                
                <a href="/InstructorAssignment/Index" class="nav-item @(currentController == "InstructorAssignment" ? "active" : "")" style="padding: 12px 16px; color: @(currentController == "InstructorAssignment" ? "white" : "#475569"); background: @(currentController == "InstructorAssignment" ? "#4f46e5" : "transparent"); text-decoration: none; border-radius: 8px; display: flex; align-items: center; gap: 12px; transition: all 0.3s; font-weight: 500;">
                    <i class="fa fa-file-text-o fa-fw"></i> Assignment Grading
                </a>
            </nav>

            <div class="sidebar-user mt-auto" style="padding: 20px; text-align: center; border-top: 1px solid #e2e8f0; margin-top: auto;">
                <img src="@profilePicture" alt="Avatar" style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #4f46e5; padding: 2px; margin-bottom: 10px;">
                <span style="display: block; font-weight: 700; color: #1e293b; margin-bottom: 15px;">@fullName</span>

                <div class="sidebar-dropdown" style="display: flex; flex-direction: column; gap: 5px;">
                    <a href="/InstructorProfile/Index" style="display: block; padding: 8px 15px; color: #475569; text-decoration: none; text-align: left; border-radius: 8px; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                        <i class="fa fa-user" style="width: 20px; text-align: center; margin-right: 8px;"></i> Instructor Profile
                    </a>
                    <a href="/InstructorProfile/Security" style="display: block; padding: 8px 15px; color: #475569; text-decoration: none; text-align: left; border-radius: 8px; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                        <i class="fa fa-key" style="width: 20px; text-align: center; margin-right: 8px;"></i> Change Password
                    </a>
                    <a href="/Identity/Logout" style="display: block; padding: 8px 15px; color: #475569; text-decoration: none; text-align: left; border-radius: 8px; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#f1f5f9';" onmouseout="this.style.backgroundColor='transparent';">
                        <i class="fa fa-sign-out" style="width: 20px; text-align: center; margin-right: 8px;"></i> Logout
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Global Toast Container (Copy từ Layout gốc) -->
    <div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1055;">
        @if (TempData["SuccessToast"] != null)
        {
            <div id="successToast" class="toast custom-toast custom-toast-success" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-center w-100">
                    <div class="custom-toast-icon"><i class="fa fa-check"></i></div>
                    <div class="custom-toast-content">
                        <div class="custom-toast-title">Successful!</div>
                        <div class="custom-toast-message">@TempData["SuccessToast"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorToast"] != null)
        {
            <div id="errorToast" class="toast custom-toast custom-toast-error" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex align-items-center w-100">
                    <div class="custom-toast-icon"><i class="fa fa-exclamation"></i></div>
                    <div class="custom-toast-content">
                        <div class="custom-toast-title">Error!</div>
                        <div class="custom-toast-message">@TempData["ErrorToast"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var successToast = document.getElementById('successToast');
            if (successToast) {
                var toast = new bootstrap.Toast(successToast, { delay: 5000 });
                toast.show();
            }
            var errorToast = document.getElementById('errorToast');
            if (errorToast) {
                var toast = new bootstrap.Toast(errorToast, { delay: 5000 });
                toast.show();
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
