@using System.Globalization
<!-- Header -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <!-- Left Side: Logo & Brand -->
            <div class="flex items-center">
                <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
                    <i class="fa fa-graduation-cap text-2xl text-blue-600"></i>
                    <span class="text-xl text-slate-900" style="letter-spacing: -0.5px;">EnglishLMS</span>
                </a>
            </div>

            <!-- Right Side: Actions (Language Switcher & User Avatar Dropdown) -->
            <div class="flex items-center gap-4">
                <!-- Language Switcher -->
                <div class="flex items-center gap-1 border border-slate-200 rounded-full p-0.5 bg-slate-50">
                    <button type="button" onclick="changeLanguage('vi')" 
                       class="px-2.5 py-0.5 rounded-full text-xs font-semibold transition-all @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "vi" ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900")">
                        VI
                    </button>
                    <button type="button" onclick="changeLanguage('en')" 
                       class="px-2.5 py-0.5 rounded-full text-xs font-semibold transition-all @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en" ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900")">
                        EN
                    </button>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- User Avatar Dropdown -->
                    <div class="relative inline-block text-left" id="user-dropdown-container">
                        <button type="button" class="flex items-center focus:outline-none" id="user-dropdown-button" aria-expanded="false" aria-haspopup="true">
                            <img src="https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(User.Identity.Name ?? "Parent"))&background=0d6efd&color=fff" 
                                 alt="Avatar" width="36" height="36" class="rounded-full shadow-sm border border-slate-200 hover:border-blue-500 transition-colors">
                        </button>
                        
                        <!-- Dropdown Menu -->
                        <div class="hidden absolute right-0 z-50 mt-2 w-56 origin-top-right rounded-xl bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none border border-slate-100" 
                             id="user-dropdown-menu" role="menu" aria-orientation="vertical" aria-labelledby="user-dropdown-button" tabindex="-1">
                            <div class="py-1" role="none">
                                <!-- User Info Header -->
                                <div class="px-4 py-2 border-b border-slate-100">
                                    <p class="text-xs text-slate-400 font-medium">@Localizer["parent_role_title"]</p>
                                    <p class="text-sm font-semibold text-slate-800 truncate">@User.Identity.Name</p>
                                </div>
                                <!-- Links -->
                                <a href="/ParentProfile" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors" role="menuitem">
                                    <i class="fa-solid fa-user-gear text-slate-400 w-4"></i> Profile
                                </a>
                                <a href="/ParentProfile/Security" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors" role="menuitem">
                                    <i class="fa fa-shield text-slate-400 w-4"></i> Security Management
                                </a>
                                <a href="/Identity/SelectRole" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors" role="menuitem">
                                    <i class="fa fa-exchange text-slate-400 w-4"></i> Switch Workspace
                                </a>
                                <hr class="border-slate-100 my-1">
                                <a href="/Identity/Logout" class="flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-rose-50 font-medium transition-colors" role="menuitem">
                                    <i class="fa fa-sign-out text-red-400 w-4"></i> Log out
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</header>

<script>
    function changeLanguage(culture) {
        // ASP.NET Core culture cookie name is ".AspNetCore.Culture"
        // Value format: c=en|uic=en
        const cookieValue = `c=${culture}|uic=${culture}`;
        
        // Save culture cookie for 1 year
        const expires = new Date();
        expires.setTime(expires.getTime() + (365 * 24 * 60 * 60 * 1000));
        document.cookie = `.AspNetCore.Culture=${encodeURIComponent(cookieValue)};expires=${expires.toUTCString()};path=/`;
        
        // Reload current page without the query string 'culture' parameter
        const url = new URL(window.location.href);
        url.searchParams.delete('culture');
        window.location.href = url.toString();
    }

    // Toggle user avatar dropdown
    document.addEventListener('DOMContentLoaded', function() {
        const button = document.getElementById('user-dropdown-button');
        const menu = document.getElementById('user-dropdown-menu');
        
        if (button && menu) {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
                const isExpanded = button.getAttribute('aria-expanded') === 'true';
                button.setAttribute('aria-expanded', !isExpanded);
                menu.classList.toggle('hidden');
            });
            
            document.addEventListener('click', function(e) {
                if (!menu.contains(e.target) && !button.contains(e.target)) {
                    menu.classList.add('hidden');
                    button.setAttribute('aria-expanded', 'false');
                }
            });
        }
    });
</script>
