@using Domain.Enums;
@model Application.Dtos.Billing.OrderDetailResponseDto

@{
    Layout = "~/Views/Parent/_Layout.cshtml";
    ViewData["Title"] = Localizer["invoice_electronic"] ?? "Chi tiết hóa đơn";
}

<div class="p-6 max-w-3xl mx-auto">
    <!-- Breadcrumb / Back button -->
    <div class="mb-6 flex justify-between items-center print:hidden">
        <a href="@Url.Action("Index", "Order")" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-800 transition font-semibold">
            <i class="fa-solid fa-arrow-left"></i>
            @Localizer["btn_back_to_orders"]
        </a>
        <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition">
            <i class="fa-solid fa-print"></i>
            @Localizer["btn_print_invoice"]
        </button>
    </div>

    <!-- Invoice Sheet -->
    <div class="bg-white rounded-3xl border border-slate-150 p-6 md:p-8 shadow-sm space-y-8 relative overflow-hidden print:border-none print:shadow-none">
        <!-- Success watermark header -->
        @if (Model.Status == OrderStatus.Paid)
        {
            <div class="absolute -top-16 -right-16 h-56 w-56 bg-emerald-50 rounded-full flex items-end justify-start p-14 opacity-30 select-none pointer-events-none">
                <i class="fa-solid fa-check text-emerald-500 text-9xl rotate-12"></i>
            </div>
        }

        <!-- Invoice Title & Branding -->
        <div class="flex justify-between items-start border-b border-slate-100 pb-6">
            <div>
                <span class="text-xs uppercase tracking-wider font-extrabold text-indigo-600 block">@Localizer["invoice_electronic"]</span>
                <h2 class="text-lg font-bold text-slate-800 mt-1">@Localizer["invoice_code"] #@Model.OrderId.ToString().Substring(0, 8).ToUpper()</h2>
                <p class="text-xs text-slate-400 mt-1">@Localizer["invoice_created_date"]: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="text-right">
                <h1 class="text-base font-extrabold text-slate-800">@Localizer["invoice_system_name"]</h1>
                <p class="text-xxs text-slate-400 mt-0.5">@Localizer["invoice_system_desc"]</p>
            </div>
        </div>

        <!-- Meta Details (Payment status & details) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-50 rounded-2xl p-4 border border-slate-100">
            <div>
                <span class="text-xxs text-slate-400 uppercase tracking-wider font-semibold block">@Localizer["invoice_payment_info"]</span>
                <div class="mt-2 space-y-1.5 text-xs text-slate-700">
                    <div class="flex gap-2">
                        <span class="text-slate-400 w-24">@Localizer["invoice_payment_method"]</span>
                        <span class="font-medium text-slate-800">@Localizer["payment_method_vnpay"]</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TxnRef))
                    {
                        <div class="flex gap-2">
                            <span class="text-slate-400 w-24">@Localizer["invoice_payment_txn_ref"]</span>
                            <span class="font-mono text-slate-800 select-all">@Model.TxnRef</span>
                        </div>
                    }
                    @if (Model.CapturedAt != null)
                    {
                        <div class="flex gap-2">
                            <span class="text-slate-400 w-24">@Localizer["invoice_payment_time"]</span>
                            <span class="font-medium text-slate-800">@Model.CapturedAt?.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="md:text-right md:border-l md:border-slate-150 md:pl-6 flex flex-col justify-between">
                <div>
                    <span class="text-xxs text-slate-400 uppercase tracking-wider font-semibold block">@Localizer["invoice_status_title"]</span>
                    <div class="mt-2.5">
                        @if (Model.Status == OrderStatus.Paid)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-600 text-xs font-bold rounded-full">
                                <i class="fa-solid fa-circle-check text-xxs"></i>
                                @Localizer["invoice_status_paid"]
                            </span>
                        }
                        else if (Model.Status == OrderStatus.Pending)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 text-amber-600 text-xs font-bold rounded-full">
                                <i class="fa-solid fa-hourglass-half text-xxs"></i>
                                @Localizer["invoice_status_pending"]
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 text-slate-550 text-xs font-bold rounded-full">
                                <i class="fa-solid fa-circle-xmark text-xxs"></i>
                                @Localizer["invoice_status_cancelled"]
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">@Localizer["invoice_service_detail"]</h3>
            <div class="border border-slate-150 rounded-2xl overflow-hidden">
                <table class="min-w-full divide-y divide-slate-100">
                    <thead class="bg-slate-50">
                        <tr>
                            <th scope="col" class="px-5 py-3 text-left text-xxs font-bold text-slate-500 uppercase tracking-wider">@Localizer["invoice_course"]</th>
                            <th scope="col" class="px-5 py-3 text-left text-xxs font-bold text-slate-500 uppercase tracking-wider">@Localizer["invoice_student"]</th>
                            <th scope="col" class="px-5 py-3 text-right text-xxs font-bold text-slate-500 uppercase tracking-wider">@Localizer["invoice_fee"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white text-xs">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="px-5 py-3 text-slate-800 font-semibold">@item.CourseName</td>
                                <td class="px-5 py-3 text-slate-600">@item.StudentName</td>
                                <td class="px-5 py-3 text-slate-900 font-bold text-right">@item.PriceVnd.ToString("N0") VND</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Total Calculation -->
        <div class="flex justify-end pt-4 border-t border-slate-100">
            <div class="w-72 space-y-2.5 text-xs">
                <div class="flex justify-between">
                    <span class="text-slate-400">@Localizer["invoice_subtotal"]</span>
                    <span class="font-medium text-slate-700">@Model.TotalAmountVnd.ToString("N0") VND</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">@Localizer["invoice_discount"]</span>
                    <span class="font-medium text-slate-700">0 VND</span>
                </div>
                <div class="flex justify-between border-t border-slate-100 pt-2.5 items-baseline">
                    <span class="text-sm font-bold text-slate-800">@Localizer["invoice_total"]</span>
                    <span class="text-base font-black text-emerald-600">@Model.TotalAmountVnd.ToString("N0") VND</span>
                </div>
            </div>
        </div>
    </div>
</div>
