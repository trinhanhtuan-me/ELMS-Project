@model Application.Dtos.Course.CoursePreviewViewModel
@{
    Layout = null;
    var course = Model.Course;
    var currentItem = Model.CurrentItem;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview: @course.Title</title>
    <!-- AlpineJS -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#4318ff',
                        secondary: '#2b3674',
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for sidebar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9; 
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }
        
        /* Video wrapper for responsive 16:9 aspect ratio */
        .video-container {
            position: relative;
            padding-bottom: 56.25%; /* 16:9 */
            height: 0;
            overflow: hidden;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }
        .video-container iframe, 
        .video-container video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-screen flex flex-col overflow-hidden font-sans">

    <!-- Top Header -->
    <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-6 shrink-0 shadow-sm z-10">
        <div class="flex items-center gap-4">
            <a href="/Course" class="text-slate-500 hover:text-primary transition-colors flex items-center gap-2 font-medium">
                <i class="fa fa-arrow-left"></i> <span>Back</span>
            </a>
            <div class="h-6 w-px bg-slate-300"></div>
            <h1 class="text-xl font-bold text-secondary truncate max-w-lg">@course.Title</h1>
            <span class="bg-blue-100 text-blue-700 text-xs px-2 py-1 rounded-full font-semibold border border-blue-200">Preview Mode</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
            <div class="flex items-center gap-1.5 text-slate-600 bg-slate-100 px-3 py-1.5 rounded-full">
                <i class="fa fa-info-circle text-primary/70"></i>
                Reading mode
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <div class="flex flex-1 overflow-hidden">
        
        <!-- Sidebar Navigation -->
        <aside class="w-80 bg-white border-r border-slate-200 flex flex-col shrink-0 custom-scrollbar overflow-y-auto">
            <div class="p-4 border-b border-slate-100 bg-slate-50/50 sticky top-0 z-10">
                <h2 class="font-bold text-secondary text-sm uppercase tracking-wider">Course content</h2>
            </div>
            
            <div class="p-2 space-y-3">
                @if (course.Modules != null && course.Modules.Any())
                {
                    foreach (var module in course.Modules)
                    {
                        <div class="rounded-lg border border-slate-200 overflow-hidden bg-white">
                            <div class="bg-slate-50 p-3 font-semibold text-secondary flex justify-between items-center text-sm border-b border-slate-200">
                                <span>Module @module.OrderIndex: @module.Title</span>
                            </div>
                            
                            <div class="flex flex-col py-1">
                                @if (module.ModuleItems != null && module.ModuleItems.Any())
                                {
                                    foreach (var item in module.ModuleItems)
                                    {
                                        bool isActive = currentItem?.Id == item.Id;
                                        string icon = "fa-file-o";
                                        string itemTitle = "Item";
                                        string typeLabel = "";
                                        
                                        if (item.ItemType == Domain.Enums.ModuleItemType.Lesson) {
                                            if (item.Lesson?.ContentType == Domain.Enums.LessonContentType.Video) {
                                                icon = "fa-video-camera text-blue-500"; itemTitle = item.Lesson.Title; typeLabel = "Video";
                                            } else {
                                                icon = "fa-file-text-o text-teal-500"; itemTitle = item.Lesson?.Title ?? "Reading"; typeLabel = "Reading";
                                            }
                                        } else if (item.ItemType == Domain.Enums.ModuleItemType.Quiz) {
                                            icon = "fa-question-circle text-amber-500"; itemTitle = item.Quiz?.Title ?? "Quiz"; typeLabel = "Quiz";
                                        } else if (item.ItemType == Domain.Enums.ModuleItemType.Assignment) {
                                            icon = "fa-tasks text-emerald-500"; itemTitle = item.Assignment?.Title ?? "Assignment"; typeLabel = "Assignment";
                                        }

                                        <a href="/Course/Preview/@course.Id?itemId=@item.Id" 
                                           class="flex items-start gap-3 px-4 py-3 hover:bg-indigo-50 transition-colors group @(isActive ? "bg-indigo-50 border-l-4 border-primary" : "border-l-4 border-transparent")">
                                            <div class="mt-0.5 w-5 text-center shrink-0">
                                                <i class="fa @icon @(isActive ? "opacity-100" : "opacity-70 group-hover:opacity-100")"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-sm font-medium @(isActive ? "text-primary" : "text-slate-700") truncate">
                                                    @itemTitle
                                                </div>
                                                <div class="text-[11px] text-slate-500 flex items-center gap-1 mt-0.5">
                                                    <i class="fa fa-clock-o"></i> @typeLabel
                                                </div>
                                            </div>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <div class="px-4 py-3 text-xs text-slate-400 italic text-center">
                                        No lessons yet
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-slate-400">
                        <i class="fa fa-folder-open-o text-3xl mb-2"></i>
                        <p class="text-sm">Course has no content yet</p>
                    </div>
                }
            </div>
        </aside>

        <!-- Main Content Viewer -->
        <main class="flex-1 bg-white custom-scrollbar overflow-y-auto relative">
            @if (currentItem != null)
            {
                <div class="max-w-4xl mx-auto py-8 px-8 pb-24">
                    
                    @* HEADER CỦA BÀI HỌC *@
                    <div class="mb-8">
                        @{
                            string mainTitle = "Untitled";
                            string mainDesc = "";
                            string badgeType = "Lesson";
                            string badgeColor = "bg-slate-100 text-slate-700";
                            
                            if (currentItem.ItemType == Domain.Enums.ModuleItemType.Lesson) {
                                mainTitle = currentItem.Lesson?.Title ?? "";
                                if (currentItem.Lesson?.ContentType == Domain.Enums.LessonContentType.Video) {
                                    badgeType = "Video Lesson";
                                    badgeColor = "bg-blue-100 text-blue-700 border-blue-200";
                                } else {
                                    badgeType = "Reading Material";
                                    badgeColor = "bg-teal-100 text-teal-700 border-teal-200";
                                }
                            } else if (currentItem.ItemType == Domain.Enums.ModuleItemType.Quiz) {
                                mainTitle = currentItem.Quiz?.Title ?? "";
                                badgeType = "Quiz Assessment";
                                badgeColor = "bg-amber-100 text-amber-700 border-amber-200";
                            } else if (currentItem.ItemType == Domain.Enums.ModuleItemType.Assignment) {
                                mainTitle = currentItem.Assignment?.Title ?? "";
                                mainDesc = "";
                                badgeType = "Assignment";
                                badgeColor = "bg-emerald-100 text-emerald-700 border-emerald-200";
                            }
                        }
                        
                        <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full border mb-3 @badgeColor">
                            @badgeType
                        </span>
                        <h2 class="text-3xl font-bold text-secondary mb-2">@mainTitle</h2>
                        @if(!string.IsNullOrEmpty(mainDesc))
                        {
                            <p class="text-slate-500">@mainDesc</p>
                        }
                    </div>

                    <div class="w-full h-px bg-slate-200 mb-8"></div>

                    @* NỘI DUNG CHI TIẾT TÙY THEO LOẠI BÀI HỌC *@
                    
                    @if (currentItem.ItemType == Domain.Enums.ModuleItemType.Lesson)
                    {
                        if (currentItem.Lesson?.ContentType == Domain.Enums.LessonContentType.Video)
                        {
                            <div class="video-container mb-6 bg-slate-900 flex items-center justify-center">
                                @if(!string.IsNullOrEmpty(currentItem.Lesson.VideoUrl))
                                {
                                    <!-- Render Video, assuming YouTube or direct MP4 link for simplicity. If direct, use video tag -->
                                    if (currentItem.Lesson.VideoUrl.Contains("youtube.com") || currentItem.Lesson.VideoUrl.Contains("youtu.be"))
                                    {
                                        // Simple youtube parser logic isn't perfect in razor, so just assuming embedded url or using iframe directly
                                        <iframe src="@currentItem.Lesson.VideoUrl.Replace("watch?v=", "embed/")" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                    }
                                    else
                                    {
                                        <video controls class="w-full h-full object-contain bg-black">
                                            <source src="@currentItem.Lesson.VideoUrl" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    }
                                }
                                else
                                {
                                    <div class="absolute inset-0 flex flex-col items-center justify-center text-slate-400">
                                        <i class="fa fa-video-camera text-4xl mb-3 opacity-50"></i>
                                        <p>Video unavailable</p>
                                    </div>
                                }
                            </div>
                            
                            @if(!string.IsNullOrEmpty(currentItem.Lesson.TextContent))
                            {
                                <div class="prose prose-slate max-w-none prose-headings:text-secondary mt-8 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                                    @Html.Raw(currentItem.Lesson.TextContent)
                                </div>
                            }
                        }
                        else
                        {
                            <!-- READING CONTENT -->
                            <div class="prose prose-slate max-w-none prose-headings:text-secondary bg-white p-8 rounded-xl border border-slate-200 shadow-sm text-lg leading-relaxed">
                                @if(!string.IsNullOrEmpty(currentItem.Lesson?.TextContent))
                                {
                                    @Html.Raw(currentItem.Lesson.TextContent)
                                }
                                else
                                {
                                    <div class="text-center py-12 text-slate-400 italic">Reading content is empty.</div>
                                }
                            </div>
                        }

                        @if (currentItem.Lesson?.LessonQuestions != null && currentItem.Lesson.LessonQuestions.Any())
                        {
                            <div class="mt-8 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                                <h3 class="text-xl font-bold mb-4">Review questions</h3>
                                <div class="space-y-4">
                                    @{int qIndex = 1;}
                                    @foreach(var q in currentItem.Lesson.LessonQuestions.OrderBy(x => x.Id))
                                    {
                                        <div class="border border-slate-200 rounded-xl p-5 bg-slate-50">
                                            <p class="font-semibold text-slate-800 mb-4"><span class="text-blue-600 mr-2">Question @qIndex:</span> @q.Content</p>
                                            <div class="space-y-2 ml-4">
                                                @if(q.LessonOptions != null)
                                                {
                                                    foreach(var opt in q.LessonOptions.OrderBy(x => x.Id))
                                                    {
                                                        <div class="flex items-center gap-2 text-sm @(opt.IsCorrect ? "text-emerald-700 font-medium" : "text-slate-600")">
                                                            <i class="fa @(opt.IsCorrect ? "fa-check-circle text-emerald-500" : "fa-circle-o text-slate-300")"></i>
                                                            @opt.Content
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            @if(!string.IsNullOrEmpty(q.Explanation))
                                            {
                                                <div class="mt-4 text-sm text-slate-600 bg-yellow-50 p-3 rounded-lg border border-yellow-100 flex gap-2">
                                                    <i class="fa fa-lightbulb-o text-yellow-500 mt-0.5 shrink-0"></i>
                                                    <span>@q.Explanation</span>
                                                </div>
                                            }
                                        </div>
                                        qIndex++;
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (currentItem.ItemType == Domain.Enums.ModuleItemType.Quiz)
                    {
                        <!-- QUIZ PREVIEW -->
                        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">
                            <div class="bg-amber-50 p-6 border-b border-amber-100 flex items-center justify-between">
                                <div>
                                    <h3 class="font-bold text-amber-900 text-lg">Quiz Configuration</h3>
                                    <div class="text-sm text-amber-700 mt-1 flex gap-4">
                                        <span><i class="fa fa-clock-o"></i> @(currentItem.Quiz?.TimeLimitMin ?? 0) minutes</span>
                                        <span><i class="fa fa-check-square-o"></i> Pass: @(currentItem.Quiz?.PassingScorePct ?? 0)%</span>
                                    </div>
                                </div>
                                <div class="bg-white px-4 py-2 rounded-lg shadow-sm font-semibold text-amber-600 border border-amber-100">
                                    Total: @(currentItem.Quiz?.QuizQuestions?.Count ?? 0) questions
                                </div>
                            </div>
                            
                            <div x-data="{ openModalId: null }" class="p-8">
                                @if(currentItem.Quiz?.QuizQuestions != null && currentItem.Quiz.QuizQuestions.Any())
                                {
                                    <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
                                        <table class="w-full text-left border-collapse">
                                            <thead>
                                                <tr class="bg-slate-50 border-b border-slate-200 text-sm font-semibold text-slate-700">
                                                    <th class="p-4 text-center w-16">STT</th>
                                                    <th class="p-4">Question content</th>
                                                    <th class="p-4 text-center w-28">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{int qIndex = 1;}
                                                @foreach(var q in currentItem.Quiz.QuizQuestions.OrderBy(x => x.Id))
                                                {
                                                    <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                                        <td class="p-4 text-center font-medium text-slate-500">@qIndex</td>
                                                        <td class="p-4">
                                                            <div class="text-slate-800 font-medium line-clamp-2">@q.Content</div>
                                                            <div class="mt-1 text-xs text-slate-500">
                                                                @(q.QuizOptions?.Count ?? 0) options
                                                            </div>
                                                        </td>
                                                        <td class="p-4">
                                                            <div class="flex justify-center">
                                                                <button type="button" @@click="openModalId = '@q.Id'" class="px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transition-colors text-sm font-medium flex items-center gap-1">
                                                                    <i class="fa fa-eye"></i> View
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    
                                                    <!-- Modal for this question -->
                                                    <div x-show="openModalId === '@q.Id'" style="display: none;" class="fixed inset-0 z-[100] overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                                                        <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                                                            <div x-show="openModalId === '@q.Id'" x-transition.opacity class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" @@click="openModalId = null"></div>
                                                            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                                                            
                                                            <div x-show="openModalId === '@q.Id'" x-transition class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full border border-slate-100">
                                                                <div class="bg-white px-6 pt-6 pb-6">
                                                                    <div class="flex justify-between items-start mb-4">
                                                                        <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                                                                            <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm">@qIndex</span>
                                                                            Question details
                                                                        </h3>
                                                                        <button @@click="openModalId = null" class="text-slate-400 hover:text-slate-600 bg-slate-50 hover:bg-slate-100 w-8 h-8 rounded-full flex items-center justify-center transition-colors">
                                                                            <i class="fa fa-times"></i>
                                                                        </button>
                                                                    </div>
                                                                    
                                                                    <div class="bg-slate-50 p-4 rounded-xl mb-6 border border-slate-100">
                                                                        <p class="text-slate-800 font-medium whitespace-pre-wrap">@q.Content</p>
                                                                        @if(!string.IsNullOrEmpty(q.Explanation))
                                                                        {
                                                                            <div class="mt-3 text-sm text-slate-600 bg-yellow-50 p-3 rounded-lg border border-yellow-100 flex gap-2">
                                                                                <i class="fa fa-lightbulb-o text-yellow-500 mt-0.5 shrink-0"></i>
                                                                                <span>@q.Explanation</span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    
                                                                    <h4 class="font-bold text-slate-700 mb-3 text-sm uppercase tracking-wider">Options</h4>
                                                                    <div class="space-y-2">
                                                                        @if(q.QuizOptions != null)
                                                                        {
                                                                            foreach(var opt in q.QuizOptions.OrderBy(x => x.Id))
                                                                            {
                                                                                <div class="flex items-start gap-3 p-3 rounded-xl border @(opt.IsCorrect ? "bg-emerald-50 border-emerald-200" : "bg-white border-slate-200")">
                                                                                    <div class="mt-0.5 shrink-0">
                                                                                        <i class="fa @(opt.IsCorrect ? "fa-check-circle text-emerald-500" : "fa-circle-o text-slate-300")"></i>
                                                                                    </div>
                                                                                    <span class="@(opt.IsCorrect ? "font-medium text-emerald-800" : "text-slate-600")">@opt.Content</span>
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <div class="bg-slate-50 px-6 py-4 flex justify-end border-t border-slate-100">
                                                                    <button type="button" @@click="openModalId = null" class="px-5 py-2 bg-white border border-slate-300 rounded-lg text-slate-700 font-medium hover:bg-slate-50 shadow-sm transition-colors">Close</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    qIndex++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-8 text-slate-400 italic">No questions in this quiz yet.</div>
                                }
                            </div>
                        </div>
                    }
                    else if (currentItem.ItemType == Domain.Enums.ModuleItemType.Assignment)
                    {
                        <!-- ASSIGNMENT PREVIEW -->
                         <div class="prose prose-slate max-w-none prose-headings:text-secondary bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
                            <div class="bg-slate-50 p-4 rounded-lg mb-6 border border-slate-200 flex gap-4 text-sm text-slate-700">
                                <div class="flex items-center gap-2"><i class="fa fa-file-text text-primary"></i> <strong>Deadline:</strong> Open deadline</div>
                            </div>
                            
                            <h3 class="text-xl font-bold mb-4">Assignment content / Requirements</h3>
                            @if(!string.IsNullOrEmpty(currentItem.Assignment?.Content))
                            {
                                <div class="prose max-w-none">
                                    @Html.Raw(currentItem.Assignment.Content)
                                </div>
                            }
                            else
                            {
                                <p class="text-slate-400 italic">No detailed content.</p>
                            }

                            @if(!string.IsNullOrEmpty(currentItem.Assignment?.Instructions))
                            {
                                <h4 class="text-lg font-bold mt-6 mb-3">Additional instructions</h4>
                                <div class="prose max-w-none">
                                    @Html.Raw(currentItem.Assignment.Instructions)
                                </div>
                            }
                            
                            <div class="mt-8 border-t border-dashed border-slate-300 pt-6">
                                <button disabled class="w-full py-3 bg-slate-200 text-slate-500 font-semibold rounded-lg cursor-not-allowed">
                                    <i class="fa fa-upload"></i> Submit (Disabled in Preview)
                                </button>
                            </div>
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center h-full text-slate-400">
                    <img src="https://illustrations.popsy.co/amber/student-going-to-school.svg" class="w-64 opacity-50 mb-4" alt="Empty" />
                    <p class="text-lg">Select a lesson from the left menu to view content.</p>
                </div>
            }
        </main>
    </div>
</body>
</html>
