@model Application.Dtos.Identity.LoginRequest

@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h3 class="text-center fw-bold mb-4">Sign In</h3>

                <form asp-controller="Identity" asp-action="Login" method="post">
                    <!-- Username -->
                    <div class="mb-3">
                        <label asp-for="Identifier" class="form-label fw-medium">Username</label>
                        <input asp-for="Identifier" class="form-control bg-light" placeholder="Enter your username or email" required />
                        <span asp-validation-for="Identifier" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-medium">Password</label>
                        <input asp-for="Password" type="password" class="form-control bg-light" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="RememberMe" id="RememberMe">
                            <label class="form-check-label text-secondary small" for="RememberMe">
                                Remember me
                            </label>
                        </div>
                        <a href="#" class="text-decoration-none small">Forgot password?</a>
                    </div>

                    <!-- Sign In Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3 rounded-3 fw-medium">
                        Sign In
                    </button>

                </form>

                @if (TempData["UnverifiedIdentifier"] != null)
                {
                    <div class="alert alert-warning mt-3 text-center" role="alert">
                        <form asp-action="ResendVerifyOtp" asp-controller="Identity" method="post">
                            <input type="hidden" name="email" value="@TempData["UnverifiedIdentifier"]" />

                            <p class="mb-2">Account have not verified yet</p>
                            <button type="submit" class="btn btn-warning btn-sm fw-bold">Resend OTP code</button>
                        </form>
                    </div>
                }
                <!-- Divider "or" -->
                <div class="d-flex align-items-center mb-3">
                    <hr class="flex-grow-1 text-muted">
                    <span class="mx-2 text-muted small">Or</span>
                    <hr class="flex-grow-1 text-muted">
                </div>

                <!-- Google Sign In -->
                <button type="button" class="btn btn-outline-secondary w-100 py-2 mb-4 rounded-3 d-flex justify-content-center align-items-center gap-2">
                    <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                    <span class="text-dark fw-medium">Sign in with Google</span>
                </button>

                <!-- Nút Đăng nhập bằng Vân tay / Passkey -->
                <button id="btn-login-passkey" type="button" class="btn btn-outline-secondary w-100 py-2 mb-4 rounded-3 d-flex justify-content-center align-items-center gap-2">
                    <i class="bi bi-key-fill text-dark" style="font-size: 1.2rem;"></i>
                    <span class="text-dark fw-medium">Sign in with Passkey</span>
                </button>

                <!-- Khu vực báo lỗi nếu quét vân tay sai -->
                <div id="passkey-login-message" class="text-center mb-3"></div>

                <!-- Sign Up Link -->
                <div class="text-center small">
                    <span class="text-muted">Don't have an account?</span>
                    <a href="/Identity/Register" class="text-decoration-none fw-medium">Sign up</a>
                </div>

                

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function coerceToArrayBuffer(base64String) {
            let base64 = base64String.replace(/-/g, "+").replace(/_/g, "/");
            let padding = base64.length % 4;
            if (padding) {
                if (padding === 1) base64 += "===";
                else if (padding === 2) base64 += "==";
                else if (padding === 3) base64 += "=";
            }
            const str = window.atob(base64);
            const bytes = new Uint8Array(str.length);
            for (let i = 0; i < str.length; i++) {
                bytes[i] = str.charCodeAt(i);
            }
            return bytes.buffer;
        }

        function coerceToBase64Url(buffer) {
            const bytes = new Uint8Array(buffer);
            let str = "";
            for (const byte of bytes) {
                str += String.fromCharCode(byte);
            }
            const base64 = window.btoa(str);
            return base64.replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
        }

        //ASSERTION
        document.getElementById('btn-login-passkey').addEventListener('click', async () => {
            const msgDiv = document.getElementById('passkey-login-message');

            const identifierInput = document.getElementById('Identifier').value;

            if (!identifierInput) {
                msgDiv.innerHTML = '<span class="text-danger fw-bold">Please enter your username or email first!</span>';
                return;
            }

            msgDiv.innerHTML = '<span class="text-info"><i class="bi bi-hourglass-split"></i> Waiting for verification...</span>';

            try {
                //MakeAssertionOptions
                const optionsResponse = await fetch('/Identity/MakeAssertionOptions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier: identifierInput })
                });

                if (!optionsResponse.ok) {
                    const err = await optionsResponse.json();
                    throw new Error(err.error || "Account has no passkey or error getting options.");
                }

                const options = await optionsResponse.json();

                options.challenge = coerceToArrayBuffer(options.challenge);
                if (options.allowCredentials) {
                    for (let cred of options.allowCredentials) {
                        cred.id = coerceToArrayBuffer(cred.id);
                    }
                }

                //dùng hàm .GET thay vì .CREATE
                const assertion = await navigator.credentials.get({ publicKey: options });

                const assertionResponse = {
                    id: assertion.id,
                    rawId: coerceToBase64Url(assertion.rawId),
                    type: assertion.type,
                    extensions: assertion.getClientExtensionResults(),
                    response: {
                        authenticatorData: coerceToBase64Url(assertion.response.authenticatorData),
                        clientDataJSON: coerceToBase64Url(assertion.response.clientDataJSON),
                        signature: coerceToBase64Url(assertion.response.signature),
                        userHandle: assertion.response.userHandle ? coerceToBase64Url(assertion.response.userHandle) : null
                    }
                };

                const loginResponse = await fetch('/Identity/MakeAssertion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        identifier: identifierInput,
                        assertion: assertionResponse //khớp DTO của C#
                    })
                });

                if (!loginResponse.ok) {
                    const err = await loginResponse.json();
                    throw new Error(err.error || "Passkey verification failed.");
                }

                const result = await loginResponse.json();

                msgDiv.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Login successful! Redirecting...</span>';
                window.location.href = result.redirectUrl || '/';

            } catch (error) {
                console.error(error);
                msgDiv.innerHTML = `<span class="text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> Error: ${error.message}</span>`;
            }
        });
    </script>
}